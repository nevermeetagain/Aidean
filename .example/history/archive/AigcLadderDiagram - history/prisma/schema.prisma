// ==================== IDE/CLI Agent System: Persona & Learning ====================

// 用户分身主表 - aidean_agent.personas
model Persona {
  id          String    @id @default(cuid())
  
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 基础信息
  name        String
  description String?
  avatar      String?
  
  // 分身配置（核心：思维习惯、责任感、审美、接受程度）
  config      Json      @map("config")
  // {
  //   "thinkingStyle": "logical" | "creative" | "pragmatic",
  //   "detailLevel": "high" | "medium" | "low",
  //   "codeStyle": "functional" | "oop" | "procedural",
  //   "namingConvention": "camelCase" | "snake_case" | "PascalCase",
  //   "riskPreference": "conservative" | "moderate" | "aggressive",
  //   "communicationStyle": "direct" | "diplomatic" | "technical",
  //   "responsibilityLevel": "owner" | "contributor" | "advisor",
  //   "aesthetics": { "ui": "minimal" | "rich", "code": "clean" | "verbose" }
  // }
  
  // 学习提取的偏好（用于快速查询）
  preferences Json      @map("preferences")
  
  // 版本快照数组（支持回滚）
  snapshots   Json[]    @default([]) @map("snapshots")
  // [{version: 1, data: {...}, createdAt: "2024-01-01", trigger: "learning"}]
  
  // 纠正历史
  corrections Json[]    @default([]) @map("corrections")
  // [{field: "thinkingStyle", old: "X", new: "Y", reason: "user_correction", correctedAt: "..."}]
  
  // 学习统计
  learnCount    Int     @default(0) @map("learn_count")
  lastLearnedAt DateTime? @map("last_learned_at")
  
  // 自动执行配置
  autoExecuteThreshold Float @default(0.99) @map("auto_execute_threshold")
  
  isActive    Boolean   @default(true) @map("is_active")
  isDefault   Boolean   @default(false) @map("is_default")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  
  // 关联
  learningSources LearningSource[]
  tasks         Task[]

  @@index([userId])
  @@index([isDefault])
  @@index([isActive])
  @@index([createdAt])
  @@map("personas")
}

// 学习数据源表 - aidean_agent.learning_sources
model LearningSource {
  id          String    @id @default(cuid())
  
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  personaId   String?   @map("persona_id")
  persona     Persona?  @relation(fields: [personaId], references: [id], onDelete: SetNull)
  
  // 数据来源类型
  sourceType  LearningSourceType @map("source_type")
  // CONVERSATION: 对话记录
  // FILE_UPLOAD: 文件上传
  // USER_CORRECTION: 用户纠正
  // MANUAL_INPUT: 手动输入
  // BEHAVIOR_LOG: 行为日志
  
  // 源引用（根据sourceType不同）
  sourceRef   String?   @map("source_ref")
  // conversationId / documentId / filePath等
  
  // 原始数据摘要（不存全文，全文在向量库）
  summary     String    @db.Text
  
  // 提取的模式（核心！自动学习的成果）
  extractedPatterns Json @map("extracted_patterns")
  // [
  //   {
  //     "type": "naming_preference",
  //     "pattern": "camelCase_for_functions",
  //     "confidence": 0.95,
  //     "evidence": ["example1", "example2"]
  //   }
  // ]
  
  // 是否已应用到分身
  applied     Boolean   @default(false) @map("applied")
  appliedAt   DateTime? @map("applied_at")
  appliedVersion Int?   @map("applied_version")
  
  // 置信度
  confidence  Float     @default(0.5) @map("confidence")
  
  // 处理状态
  status      LearningStatus @default(PENDING) @map("status")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([userId])
  @@index([personaId])
  @@index([sourceType])
  @@index([status])
  @@index([applied])
  @@index([createdAt])
  @@map("learning_sources")
}

enum LearningSourceType {
  CONVERSATION   @map("conversation")
  FILE_UPLOAD    @map("file_upload")
  USER_CORRECTION @map("user_correction")
  MANUAL_INPUT   @map("manual_input")
  BEHAVIOR_LOG   @map("behavior_log")
}

enum LearningStatus {
  PENDING     @map("pending")
  PROCESSING  @map("processing")
  PROCESSED   @map("processed")
  FAILED      @map("failed")
  REJECTED    @map("rejected")
}

// 对话记录表 - aidean_agent.conversations
model Conversation {
  id          String    @id @default(cuid())
  
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 会话元数据
  title       String?
  messageCount Int      @default(0) @map("message_count")
  
  // 关联的分身（如果是用分身执行的）
  personaId   String?   @map("persona_id")
  
  // 向量引用（实际内容在Qdrant）
  vectorIds   String[]  @default([]) @map("vector_ids")
  
  // 提取的洞察（自动总结）
  insights    Json?     @map("insights")
  // {
  //   "topics": ["react", "api_design", "database"],
  //   "complexity": "high",
  //   "patterns": ["functional_style", "type_safe"],
  //   "satisfaction": 0.9
  // }
  
  // 会话类型
  type        ConversationType @default(NORMAL) @map("type")
  // NORMAL / AUTO_EXECUTE / MULTI_AGENT / DEBUG
  
  // 是否已学习提取
  isLearned   Boolean   @default(false) @map("is_learned")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([userId])
  @@index([personaId])
  @@index([type])
  @@index([isLearned])
  @@index([createdAt])
  @@map("conversations")
}

enum ConversationType {
  NORMAL       @map("normal")
  AUTO_EXECUTE @map("auto_execute")
  MULTI_AGENT  @map("multi_agent")
  DEBUG        @map("debug")
  WORKFLOW     @map("workflow")
}

// ==================== Document & Knowledge System ====================

// 文档管理表 - aidean_agent.documents
model Document {
  id          String    @id @default(cuid())
  
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 文件信息
  filename    String
  fileType    DocumentType @map("file_type")
  // TXT / MARKDOWN / WORD / EXCEL / PDF / IMAGE / CODE
  
  fileSize    Int       @map("file_size")
  mimeType    String    @map("mime_type")
  
  // 存储路径（本地/云）
  storagePath String    @map("storage_path")
  
  // 解析内容摘要
  summary     String?   @db.Text
  
  // 向量引用（Qdrant/Milvus等向量库）
  vectorId    String?   @map("vector_id")
  
  // OCR结果（图片/PDF时）
  ocrResult   Json?     @map("ocr_result")
  // {
  //   "text": "extracted text",
  //   "blocks": [{"text": "...", "bbox": [x,y,w,h], "type": "text/table"}],
  //   "confidence": 0.95
  // }
  
  // 提取的实体/标签
  entities    String[]  @default([])
  tags        String[]  @default([])
  
  // 文档状态
  status      DocumentStatus @default(PENDING) @map("status")
  // PENDING / PROCESSING / PROCESSED / FAILED
  
  // 是否已用于学习
  isLearned   Boolean   @default(false) @map("is_learned")
  learnedAt   DateTime? @map("learned_at")
  
  // 文档版本（用于论文等多次修改的场景）
  version     Int       @default(1)
  parentId    String?   @map("parent_id")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([userId])
  @@index([fileType])
  @@index([status])
  @@index([isLearned])
  @@index([vectorId])
  @@index([createdAt])
  @@map("documents")
}

enum DocumentType {
  TXT       @map("txt")
  MARKDOWN  @map("markdown")
  WORD      @map("word")
  EXCEL     @map("excel")
  PDF       @map("pdf")
  IMAGE     @map("image")
  CODE      @map("code")
  OTHER     @map("other")
}

enum DocumentStatus {
  PENDING     @map("pending")
  PROCESSING  @map("processing")
  PROCESSED   @map("processed")
  FAILED      @map("failed")
}

// ==================== Task Execution System ====================

// 任务表 - aidean_agent.tasks
model Task {
  id          String    @id @default(cuid())
  
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 关联的分身
  personaId   String?   @map("persona_id")
  persona     Persona?  @relation(fields: [personaId], references: [id], onDelete: SetNull)
  
  // 任务定义
  title       String
  description String?   @db.Text
  
  // 执行计划（JSON格式的工作流定义）
  plan        Json      @map("plan")
  // {
  //   "steps": [
  //     {
  //       "id": "step-1",
  //       "type": "skill" | "mcp" | "agent" | "code" | "doc",
  //       "tool": "readFile" | "writeFile" | "executeCommand" | "httpRequest",
  //       "input": {...},
  //       "dependsOn": ["step-0"],
  //       "condition": "optional_condition"
  //     }
  //   ],
  //   "parallelGroups": [["step-1", "step-2"]],
  //   "onError": "rollback" | "skip" | "pause"
  // }
  
  // 任务状态
  status      TaskStatus @default(PENDING) @map("status")
  // PENDING / RUNNING / COMPLETED / FAILED / ROLLBACKING / ROLLBACKED / PAUSED
  
  // 自动执行配置
  autoExecute Boolean   @default(false) @map("auto_execute")
  confidence  Float?    @map("confidence")
  // 理解置信度（99%理解度检测）
  
  // 执行统计
  progress    Float     @default(0) @map("progress")
  // 0-100
  currentStep String?   @map("current_step")
  
  // 时间戳
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  estimatedDuration Int? @map("estimated_duration")
  // 预估完成时间（秒）
  
  // 来源
  source      TaskSource @default(MANUAL) @map("source")
  // MANUAL / REMOTE / SCHEDULED / WEBHOOK
  sourceRef   String?   @map("source_ref")

  // 关联表
  steps       TaskStep[]
  artifacts   TaskArtifact[]
  notifications TaskNotification[]
  rollbacks   TaskRollback[]

  @@index([userId])
  @@index([personaId])
  @@index([status])
  @@index([autoExecute])
  @@index([createdAt])
  @@map("tasks")
}

enum TaskStatus {
  PENDING       @map("pending")
  RUNNING       @map("running")
  COMPLETED     @map("completed")
  FAILED        @map("failed")
  ROLLBACKING   @map("rollbacking")
  ROLLBACKED    @map("rollbacked")
  PAUSED        @map("paused")
  CANCELLED     @map("cancelled")
}

enum TaskSource {
  MANUAL    @map("manual")
  REMOTE    @map("remote")
  SCHEDULED @map("scheduled")
  WEBHOOK   @map("webhook")
}

// 任务步骤表 - aidean_agent.task_steps
model TaskStep {
  id          String    @id @default(cuid())
  
  taskId      String    @map("task_id")
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  // 步骤信息
  stepOrder   Int       @map("step_order")
  stepId      String    @map("step_id")
  // 工作流定义中的步骤ID
  
  type        StepType  @map("type")
  // SKILL / MCP / AGENT / CODE / DOC / SHELL / HTTP
  
  tool        String    @map("tool")
  // 具体工具名：readFile / writeFile / executeCommand / httpRequest等
  
  // 输入输出
  input       Json      @map("input")
  output      Json?     @map("output")
  error       String?   @db.Text
  
  // 状态
  status      StepStatus @default(PENDING) @map("status")
  
  // 执行时间
  duration    Int?      @map("duration")
  // 毫秒
  
  // 检查点（用于回滚）
  checkpoint  Json?     @map("checkpoint")
  // {
  //   "fileStates": [
  //     {"path": "src/index.ts", "content": "...", "hash": "sha256", "operation": "modified"}
  //   ],
  //   "dbStates": [...],
  //   "envVars": {...}
  // }
  
  // 重试配置
  retryCount  Int       @default(0) @map("retry_count")
  maxRetries  Int       @default(3) @map("max_retries")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  // 关联产出物
  artifacts   TaskArtifact[]

  @@index([taskId])
  @@index([status])
  @@index([stepOrder])
  @@index([createdAt])
  @@map("task_steps")
}

enum StepType {
  SKILL   @map("skill")
  MCP     @map("mcp")
  AGENT   @map("agent")
  CODE    @map("code")
  DOC     @map("doc")
  SHELL   @map("shell")
  HTTP    @map("http")
  LLM     @map("llm")
}

enum StepStatus {
  PENDING     @map("pending")
  RUNNING     @map("running")
  COMPLETED   @map("completed")
  FAILED      @map("failed")
  SKIPPED     @map("skipped")
  ROLLED_BACK @map("rolled_back")
}

// 任务回滚记录表 - aidean_agent.task_rollbacks
model TaskRollback {
  id          String    @id @default(cuid())
  
  taskId      String    @map("task_id")
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stepId      String    @map("step_id")
  
  // 回滚快照
  snapshot    Json      @map("snapshot")
  // 完整的文件/数据库状态快照
  
  // 回滚原因
  reason      RollbackReason @map("rollback_reason")
  // USER_REQUEST / ERROR / TIMEOUT / SAFETY_CHECK / MANUAL
  
  reasonDetail String?  @map("reason_detail")
  
  // 回滚范围
  scope       RollbackScope @default(FULL) @map("rollback_scope")
  // FULL / PARTIAL
  
  // 影响统计
  filesRestored Int     @default(0) @map("files_restored")
  stepsRolledBack Int   @default(0) @map("steps_rolled_back")
  
  rolledBackAt DateTime @default(now()) @map("rolled_back_at")
  rolledBackBy String   @map("rolled_back_by")
  // user_id / system / persona_id

  @@index([taskId])
  @@index([stepId])
  @@index([rolledBackAt])
  @@map("task_rollbacks")
}

enum RollbackReason {
  USER_REQUEST    @map("user_request")
  ERROR           @map("error")
  TIMEOUT         @map("timeout")
  SAFETY_CHECK    @map("safety_check")
  MANUAL          @map("manual")
}

enum RollbackScope {
  FULL    @map("full")
  PARTIAL @map("partial")
}

// ==================== Tool Registry System ====================

// 工具注册表 - aidean_agent.tool_registries
model ToolRegistry {
  id          String    @id @default(cuid())
  
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 工具类型
  type        ToolType  @map("type")
  // SKILL / MCP / AGENT / KERNEL
  
  // 工具标识
  name        String
  displayName String?   @map("display_name")
  version     String    @default("1.0.0")
  description String?   @db.Text
  
  // 工具配置（核心）
  config      Json      @map("config")
  // SKILL: {entryPoint, dependencies, permissions}
  // MCP: {serverUrl, transport: "stdio"|"http", tools: [...]}
  // AGENT: {model, systemPrompt, capabilities, parentId, childIds}
  // KERNEL: {type: "opencode"|"claudecode", installPath, configPath}
  
  // 权限配置
  permissions Json?     @map("permissions")
  // {read: ["**/*.ts"], write: ["src/**"], delete: [], execute: ["npm", "git"]}
  
  // 操作范围
  scope       ToolScope @default(SELECTED) @map("scope")
  // GLOBAL / SELECTED / NONE
  
  selectedPaths String[] @default([]) @map("selected_paths")
  // 当scope=SELECTED时，允许操作的目录列表
  
  // 输出规则
  outputRule  OutputRule @default(STREAM) @map("output_rule")
  // STREAM / BUFFER / NONE
  
  // 调用规则（Agent类型时）
  callRule    CallRule?  @map("call_rule")
  // SEQUENTIAL / PARALLEL / NONE
  
  callScenario String?   @map("call_scenario")
  // 调用场景描述
  
  // 使用统计
  useCount    Int       @default(0) @map("use_count")
  avgLatency  Float?    @map("avg_latency")
  // 平均响应时间（ms）
  lastUsedAt  DateTime? @map("last_used_at")
  
  // 状态
  isEnabled   Boolean   @default(true) @map("is_enabled")
  isPublic    Boolean   @default(false) @map("is_public")
  // 是否对外暴露
  
  // 外部暴露配置（当isPublic=true时）
  publicConfig Json?    @map("public_config")
  // {endpoint, authType, rateLimit, accessToken}
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  
  // 关联
  executions  ToolExecution[]

  @@index([userId])
  @@index([type])
  @@index([name])
  @@index([isEnabled])
  @@index([isPublic])
  @@index([createdAt])
  @@map("tool_registries")
}

enum ToolType {
  SKILL   @map("skill")
  MCP     @map("mcp")
  AGENT   @map("agent")
  KERNEL  @map("kernel")
}

enum ToolScope {
  GLOBAL   @map("global")
  SELECTED @map("selected")
  NONE     @map("none")
}

enum OutputRule {
  STREAM  @map("stream")
  BUFFER  @map("buffer")
  NONE    @map("none")
}

enum CallRule {
  SEQUENTIAL @map("sequential")
  PARALLEL   @map("parallel")
  NONE       @map("none")
}

// 工具执行日志表 - aidean_agent.tool_executions
model ToolExecution {
  id          String    @id @default(cuid())
  
  toolId      String    @map("tool_id")
  tool        ToolRegistry @relation(fields: [toolId], references: [id], onDelete: Cascade)
  
  // 关联的任务（可选）
  taskId      String?   @map("task_id")
  
  // 调用上下文
  context     Json?     @map("context")
  // {conversationId, stepId, trigger: "manual"|"auto"|"workflow"}
  
  // 输入输出
  input       Json      @map("input")
  output      Json?     @map("output")
  error       String?   @db.Text
  
  // 性能指标
  latency     Int       @map("latency")
  // 毫秒
  tokensUsed  Int?      @map("tokens_used")
  // LLM调用时的token消耗
  
  // 状态
  status      ExecutionStatus @map("status")
  // SUCCESS / FAILED / TIMEOUT / CANCELLED
  
  // 安全审计
  filesAccessed String[] @default([]) @map("files_accessed")
  commandsExecuted String[] @default([]) @map("commands_executed")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([toolId])
  @@index([taskId])
  @@index([status])
  @@index([createdAt])
  @@map("tool_executions")
}

enum ExecutionStatus {
  SUCCESS    @map("success")
  FAILED     @map("failed")
  TIMEOUT    @map("timeout")
  CANCELLED  @map("cancelled")
}

// ==================== Remote Control System (ACP) ====================

// 远程控制通道表 - aidean_agent.remote_channels
model RemoteChannel {
  id          String    @id @default(cuid())
  
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 通道类型
  type        ChannelType @map("type")
  // WEBHOOK / WECHAT / WECHAT_WORK / DINGTALK / FEISHU / QQ / APP
  
  // 通道名称（用户自定义）
  name        String
  
  // 配置（加密存储敏感信息）
  config      Json      @map("config")
  // WEBHOOK: {url, secret, headers}
  // WECHAT: {appId, appSecret, token, encodingAESKey}
  // DINGTALK: {appKey, appSecret, robotCode}
  // FEISHU: {appId, appSecret, encryptKey}
  
  // 功能开关
  features    Json      @map("features")
  // {
  //   "textCommand": true,
  //   "voiceCommand": false,
  //   "imageCommand": true,
  //   "progressNotification": true,
  //   "completionNotification": true
  // }
  
  // 语音配置
  voiceConfig Json?     @map("voice_config")
  // {
  //   "inputEnabled": true,
  //   "outputEnabled": false,
  //   "inputLanguage": "zh-CN",
  //   "outputLanguage": "zh-CN",
  //   "voiceId": "xiaoyan"
  // }
  
  // 通知模板
  templates   Json?     @map("templates")
  // {
  //   "taskStarted": "任务【{title}】已开始执行",
  //   "taskCompleted": "任务【{title}】已完成，耗时{duration}秒",
  //   "taskFailed": "任务【{title}】执行失败: {error}"
  // }
  
  // 状态
  isEnabled   Boolean   @default(false) @map("is_enabled")
  lastPingAt  DateTime? @map("last_ping_at")
  
  // 验证状态
  isVerified  Boolean   @default(false) @map("is_verified")
  verifiedAt  DateTime? @map("verified_at")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  
  // 关联
  commands    RemoteCommand[]

  @@index([userId])
  @@index([type])
  @@index([isEnabled])
  @@index([createdAt])
  @@map("remote_channels")
}

enum ChannelType {
  WEBHOOK      @map("webhook")
  WECHAT       @map("wechat")
  WECHAT_WORK  @map("wechat_work")
  DINGTALK     @map("dingtalk")
  FEISHU       @map("feishu")
  QQ           @map("qq")
  APP          @map("app")
}

// 远程命令表 - aidean_agent.remote_commands
model RemoteCommand {
  id          String    @id @default(cuid())
  
  channelId   String    @map("channel_id")
  channel     RemoteChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  // 原始指令
  rawCommand  String    @map("raw_command") @db.Text
  // 用户发送的原始文本/语音转文字
  
  // 指令类型
  commandType CommandType @map("command_type")
  // TEXT / VOICE / IMAGE / FILE
  
  // 媒体资源（语音/图片时）
  mediaUrl    String?   @map("media_url")
  mediaData   Json?     @map("media_data")
  // {duration, format, size}等
  
  // 解析后的意图
  intent      String    @map("intent")
  // EXECUTE_TASK / QUERY_PROGRESS / CANCEL_TASK / CONFIG / CHAT
  
  // 解析参数
  parameters  Json      @map("parameters")
  // {taskDescription, priority, autoExecute, etc.}
  
  // 置信度
  confidence  Float     @default(0) @map("confidence")
  
  // 关联的任务
  taskId      String?   @map("task_id")
  
  // 执行结果
  result      Json?     @map("result")
  // {success, message, data}
  
  // 状态
  status      CommandStatus @default(RECEIVED) @map("status")
  // RECEIVED / PARSING / CONFIRMING / EXECUTING / COMPLETED / FAILED / CANCELLED
  
  // 是否需要确认（置信度不够时）
  needConfirm Boolean   @default(false) @map("need_confirm")
  confirmedAt DateTime? @map("confirmed_at")
  
  // 时间戳
  createdAt   DateTime  @default(now()) @map("created_at")
  parsedAt    DateTime? @map("parsed_at")
  executedAt  DateTime? @map("executed_at")
  completedAt DateTime? @map("completed_at")

  @@index([channelId])
  @@index([status])
  @@index([intent])
  @@index([taskId])
  @@index([createdAt])
  @@map("remote_commands")
}

enum CommandType {
  TEXT  @map("text")
  VOICE @map("voice")
  IMAGE @map("image")
  FILE  @map("file")
}

enum CommandStatus {
  RECEIVED   @map("received")
  PARSING    @map("parsing")
  CONFIRMING @map("confirming")
  EXECUTING  @map("executing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")
  CANCELLED  @map("cancelled")
}

// ==================== Document Template System ====================

// 文档模板表 - aidean_agent.doc_templates
model DocTemplate {
