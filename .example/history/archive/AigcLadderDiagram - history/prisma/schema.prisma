// 第三部分：执行增强与系统支撑表
// ============================================================

// 1. 任务产出物表 - 存储任务执行产生的文件、代码、文档等
model TaskArtifact {
  id          String   @id @default(cuid())
  
  taskId      String   @map("task_id")
  stepId      String?  @map("step_id")
  
  // 产出物类型: FILE / CODE / DOC / IMAGE / DATA / OTHER
  type        String   @map("type")
  name        String   @map("name")
  
  // 内容存储（小内容直接存，大内容存路径）
  content     String?  @db.Text @map("content")
  storagePath String?  @map("storage_path")
  
  mimeType    String   @map("mime_type")
  size        Int      @map("size")
  
  // 元数据
  metadata    Json?    @map("metadata")
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  // 关联
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  step        TaskStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  
  @@index([taskId])
  @@index([stepId])
  @@index([type])
  @@index([createdAt])
  @@map("task_artifacts")
}

// 2. 任务通知表 - 任务状态变更通知记录
model TaskNotification {
  id          String    @id @default(cuid())
  
  taskId      String    @map("task_id")
  userId      String    @map("user_id")
  
  // 通知渠道: WEB / EMAIL / WECHAT / DINGTALK / FEISHU / SMS
  channel     String    @map("channel")
  
  // 通知类型: STARTED / PROGRESS / COMPLETED / FAILED / ROLLBACKED / NEED_CONFIRM
  type        String    @map("type")
  
  title       String    @map("title")
  content     String    @db.Text @map("content")
  
  // 动作链接
  actionUrl   String?   @map("action_url")
  
  // 发送状态
  sentAt      DateTime? @map("sent_at")
  errorInfo   String?   @map("error_info")
  
  // 阅读状态
  readAt      DateTime? @map("read_at")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  
  // 关联
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([taskId])
  @@index([userId])
  @@index([channel])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
  @@map("task_notifications")
}

// 3. 多智能体团队表 - Agent协作配置
model AgentTeam {
  id          String    @id @default(cuid())
  
  userId      String    @map("user_id")
  
  name        String    @map("name")
  description String?   @map("description")
  
  // 团队成员配置（JSON存储灵活结构）
  // [{agentId, role: "parent"|"child", callOrder, model, permissions, instructions}]
  members     Json      @map("members")
  
  // 协作流程定义
  workflow    Json?     @map("workflow")
  
  // 共享上下文配置
  sharedContext Json?   @map("shared_context")
  
  isActive    Boolean   @default(true) @map("is_active")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // 关联
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isActive])
  @@map("agent_teams")
}

// 4. 模型提供商配置表 - 用户自定义模型配置
model ModelProvider {
  id          String    @id @default(cuid())
  
  userId      String    @map("user_id")
  
  name        String    @map("name")
  
  // 协议类型: openai / anthropic / gemini / claude / custom
  protocol    String    @map("protocol")
  
  baseUrl     String    @map("base_url")
  
  // API密钥（加密存储）
  apiKey      String    @map("api_key")
  
  // 支持的模型列表
  models      Json      @map("models")
  
  // 默认参数
  defaultParams Json? @map("default_params")
  
  // 限额配置
  rateLimit   Json?     @map("rate_limit")
  
  isDefault   Boolean   @default(false) @map("is_default")
  isActive    Boolean   @default(true) @map("is_active")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // 关联
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, name])
  @@index([userId])
  @@index([protocol])
  @@index([isDefault])
  @@map("model_providers")
}

// 5. 系统指标表 - 性能监控和统计分析
model SystemMetric {
  id          String   @id @default(cuid())
  
  // 指标类型: TASK_COUNT / LATENCY / ERROR_RATE / TOKEN_USAGE / COST
  metricType  String   @map("metric_type")
  
  value       Float    @map("value")
  
  // 标签（用于多维度筛选）
  // {userId?, toolType?, status?, model?, hour?}
  labels      Json     @map("labels")
  
  recordedAt  DateTime @map("recorded_at")
  
  // 聚合周期: raw / minute / hour / day
  period      String   @default("raw") @map("period")
  
  @@index([metricType])
  @@index([recordedAt])
  @@index([period])
  @@index([labels])
  @@map("system_metrics")
}

// 7. 消息收件箱表 - 用户系统通知（区别于原有的UserNotification）
model InboxNotification {
  id          String    @id @default(cuid())
  
  userId      String    @map("user_id")
  
  // 通知类型: SYSTEM / TASK / SECURITY / BILLING / FEATURE
  type        String    @map("type")
  
  priority    String    @default("normal") @map("priority")
  // urgent / high / normal / low
  
  title       String    @map("title")
  content     String    @db.Text @map("content")
  
  // 动作按钮
  actionUrl   String?   @map("action_url")
  actionText  String?   @map("action_text")
  
  // 图标/图片
  icon        String?   @map("icon")
  imageUrl    String?   @map("image_url")
  
  // 过期时间
  expiresAt   DateTime? @map("expires_at")
  
  // 阅读状态
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  
  // 关联
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([priority])
  @@index([createdAt])
  @@map("inbox_notifications")
}

// 8. 通知设置表 - 用户通知偏好配置
model NotificationSetting {
  id          String    @id @default(cuid())
  
  userId      String    @map("user_id")
  
  // 事件类型: task_completed / task_failed / security_alert / 
  // billing_reminder / feature_update / system_maintenance
  eventType   String    @map("event_type")
  
  // 通知渠道: ["web", "email", "wechat", "dingtalk", "sms"]
  channels    Json      @map("channels")
  
  // 是否启用
  enabled     Boolean   @default(true) @map("enabled")
  
  // 静默时间段
  quietHours  Json?     @map("quiet_hours")
  // {start: "22:00", end: "08:00", timezone: "Asia/Shanghai"}
  
  // 频率限制
  throttle    Json?     @map("throttle")
  // {maxPerHour: 5, digestMode: true}
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // 关联
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, eventType])
  @@index([userId])
  @@map("notification_settings")
}

// 9. 用户反馈表 - Bug报告、功能建议、投诉
model Feedback {
  id          String    @id @default(cuid())
  
  userId      String    @map("user_id")
  
  // 反馈类型: BUG / FEATURE / COMPLAINT / QUESTION / PRAISE
  type        String    @map("type")
  
  // 分类标签
  category    String?   @map("category")
  
  subject     String    @map("subject")
  content     String    @db.Text @map("content")
  
  // 附件列表
  attachments Json?     @map("attachments")
  // [{name, url, type, size}]
  
  // 状态: PENDING / PROCESSING / RESOLVED / REJECTED / CLOSED
  status      String    @default("pending") @map("status")
  
  // 优先级: urgent / high / normal / low
  priority    String    @default("normal") @map("priority")
  
  // 分配处理人
  assigneeId  String?   @map("assignee_id")
  
  // 解决信息
  resolution  String?   @map("resolution")
  resolvedAt  DateTime? @map("resolved_at")
  
  // 用户满意度
  rating      Int?      @map("rating")
  
  // 时间戳
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // 关联
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 关联回复
  comments    FeedbackComment[]
  
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("feedback")
}

// 10. 反馈回复表 - 反馈处理的对话记录
model FeedbackComment {
  id          String    @id @default(cuid())
  
  feedbackId  String    @map("feedback_id")
  userId      String    @map("user_id")
  
  content     String    @db.Text @map("content")
  
  // 是否内部备注（用户不可见）
  isInternal  Boolean   @default(false) @map("is_internal")
  
  // 附件
  attachments Json?     @map("attachments")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  
  // 关联
  feedback    Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([feedbackId])
  @@index([userId])
  @@index([isInternal])
  @@index([createdAt])
  @@map("feedback_comments")
}

// ==================== Data Audit & Rollback ====================

// 模型变更历史表 - 支持字段级变更追踪和精准回滚
model ModelChangeLog {
  id              String    @id @default(cuid())
  
  // 关联模型
  modelId         String    @map("model_id")
  model           AiModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  // 同步批次
  syncBatchId     String?   @map("sync_batch_id")
  syncBatch       SyncBatch? @relation(fields: [syncBatchId], references: [id], onDelete: SetNull)
  
  // 变更类型: CREATE | UPDATE | DELETE | SYNC
  changeType      String    @map("change_type")
  
  // 变更前数据快照
  beforeData      Json?     @map("before_data")
  // 变更后数据快照
  afterData       Json?     @map("after_data")
  // 变更字段摘要
  changedFields   String[]  @map("changed_fields")
  
  // 变更来源
  source          String?   @map("source") // sync_script | admin_manual | api
  sourceIp        String?   @map("source_ip")
  operatorId      String?   @map("operator_id")
  
  // 回滚状态
  isReverted      Boolean   @default(false) @map("is_reverted")
  revertedAt      DateTime? @map("reverted_at")
  revertReason    String?   @map("revert_reason")
  
  // 校验状态
  validationStatus String   @default("pending") @map("validation_status") // pending | valid | invalid
  checksum        String?   @map("checksum")
  
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([modelId, createdAt])
  @@index([syncBatchId])
  @@index([changeType, createdAt])
  @@index([isReverted])
  @@index([validationStatus])
  @@map("model_change_logs")
}

// 同步批次表 - 追踪模型数据同步批次，支持批量回滚
model SyncBatch {
  id              String    @id @default(cuid())
  
  // 批次编号
  batchCode       String    @unique @map("batch_code")
  
  // 来源信息
  source          String?   @map("source") // official_api | crawler | manual
  sourceUrl       String?   @map("source_url")
  
  // 统计信息
  totalRecords    Int       @default(0) @map("total_records")
  successRecords  Int       @default(0) @map("success_records")
  failedRecords   Int       @default(0) @map("failed_records")
  
  // 状态: running | completed | failed | partial
  status          String    @default("running") @map("status")
  
  // 校验结果
  validationSummary Json? @map("validation_summary")
  errorSamples    Json?   @map("error_samples")
  
  // 操作信息
  operatorId      String? @map("operator_id")
  operatorNotes   String? @map("operator_notes")
  
  // 关联变更日志
  changeLogs      ModelChangeLog[]
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([batchCode])
  @@index([status, createdAt])
  @@map("sync_batches")
}

// 自定义评分指标表 - 用户可配置自定义评分公式
model CustomMetric {
  id              String    @id @default(cuid())
  
  // 唯一编码
  metricCode      String    @unique @map("metric_code")
  
  // 基础信息
  name            String
  description     String?
  
  // 计算公式
  formulaExpression String? @map("formula_expression") // 如："reasoning_score / (price_input * 100)"
  formulaJson     Json?   @map("formula_json")        // 结构化存储
  
  // 数据源配置
  sourceTables    String[] @map("source_tables")      // ['model_scores', 'model_prices']
  sourceFields    String[] @map("source_fields")      // ['reasoning_score', 'price_input']
  
  // 计算配置
  calcFrequency   String   @default("on_demand") @map("calc_frequency") // on_demand | realtime | hourly | daily
  lastCalculatedAt DateTime? @map("last_calculated_at")
  cacheDuration   Int      @default(300) @map("cache_duration") // 秒
  
  // 状态
  isActive        Boolean  @default(true) @map("is_active")
  isPublic        Boolean  @default(false) @map("is_public")
  status          String   @default("active") @map("status") // active | disabled | archived
  
  // 创建者
  createdBy       String?  @map("created_by")
  userId          String?  @map("user_id")
  
  // 关联值
  metricValues    CustomMetricValue[]
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([metricCode])
  @@index([userId])
  @@index([isActive])
  @@index([status])
  @@index([calcFrequency])
  @@map("custom_metrics")
}

// 自定义指标值表 - 预计算结果，支持快速查询和缓存
model CustomMetricValue {
  id              String    @id @default(cuid())
  
  // 关联自定义指标
  metricId        String    @map("metric_id")
  metric          CustomMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  
  // 关联模型
  modelId         String    @map("model_id")
  model           AiModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  // 计算值
  rawValue        Float?    @map("raw_value")           // 原始计算结果
  normalizedValue Float?    @map("normalized_value")     // 归一化后（0-100）
  rankPosition    Int?      @map("rank_position")       // 在该指标下的排名
  
  // 计算详情（可追溯）
  calcDetails     Json?     @map("calc_details")        // { numerator_value, denominator_value, calc_at }
  
  // 缓存控制
  calcVersion     Int       @default(1) @map("calc_version")
  expiresAt       DateTime? @map("expires_at")           // 缓存过期时间
  
  // 状态
  status          String    @default("active") @map("status") // active | stale | error
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([metricId, modelId, calcVersion])
  @@index([metricId, rankPosition])
  @@index([modelId])
  @@index([expiresAt])
  @@index([status])
  @@map("custom_metric_values")
}

