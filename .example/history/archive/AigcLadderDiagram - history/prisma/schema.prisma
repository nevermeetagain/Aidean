}

// 资源标签关联表
model ResourceTag {
  id              String    @id @default(cuid())
  
  tagId           String    @map("tag_id")
  tag             Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  resourceType    String    @map("resource_type") // model | skill | mcp | vendor
  resourceId      String    @map("resource_id")
  resourceWeight  Int       @default(0) @map("resource_weight")
  
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([tagId, resourceType, resourceId])
  @@index([tagId])
  @@index([resourceType, resourceId])
  @@map("resource_tags")
}

// ==================== RBAC权限体系 ====================

// 角色表 - RBAC角色定义
model Role {
  id          String    @id @default(cuid())
  
  // 业务字段
  code        String    @unique
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  sortOrder   Int       @default(0) @map("sort_order")
  
  // 状态字段
  status      Int       @default(1) // 0-禁用 1-正常 2-弃用
  isActive    Boolean   @default(true) @map("is_active")
  
  // 租户
  tenantId    String    @default("0") @map("tenant_id")
  
  // 关联
  userRoleMappings   UserRoleMapping[]
  rolePermissions RolePermission[]
  
  // 审计
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  version     Int       @default(1)
  
  // 扩展
  extJson     Json?     @map("ext_json")
  
  @@index([code])
  @@index([status])
  @@index([isActive])
  @@index([tenantId])
  @@map("roles")
}

// 权限表 - 资源-操作权限定义
model Permission {
  id          String    @id @default(cuid())
  
  // 业务字段
  code        String    @unique
  name        String
  resource    String    // model, skill, user, system等
  action      String    // create, read, update, delete, execute
  description String?
  
  // 状态
  status      Int       @default(1) // 0-禁用 1-正常 2-弃用
  isActive    Boolean   @default(true) @map("is_active")
  
  // 关联
  rolePermissions RolePermission[]
  
  // 审计
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  version     Int       @default(1)
  
  // 扩展
  extJson     Json?     @map("ext_json")
  
  @@index([resource])
  @@index([action])
  @@index([status])
  @@map("permissions")
}

// 用户角色关联表
model UserRoleMapping {
  id          String    @id @default(cuid())
  
  // 关联
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  roleId      String    @map("role_id")
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  // 租户
  tenantId    String    @default("0") @map("tenant_id")
  
  // 授权信息
  grantedBy   String?   @map("granted_by")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  expiresAt   DateTime? @map("expires_at")
  
  // 状态
  status      Int       @default(1)
  isActive    Boolean   @default(true) @map("is_active")
  
  // 审计
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  version     Int       @default(1)
  
  // 扩展
  extJson     Json?     @map("ext_json")
  
  @@unique([userId, roleId, tenantId])
  @@index([userId])
  @@index([roleId])
  @@index([tenantId])
  @@index([status])
  @@index([expiresAt])
  @@map("user_roles")
}

// 角色权限关联表
model RolePermission {
  id          String    @id @default(cuid())
  
  // 关联
  roleId      String    @map("role_id")
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  permissionId String   @map("permission_id")
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  // 权限条件
  conditions  Json?     // {"own_data_only": true}
  
  // 状态
  status      Int       @default(1)
  isActive    Boolean   @default(true) @map("is_active")
  
  // 审计
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  version     Int       @default(1)
  
  // 扩展
  extJson     Json?     @map("ext_json")
  
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ==================== 组织架构 ====================

// 部门表
model Department {
  id          String    @id @default(cuid())
  
  // 层级
  parentId    String?   @map("parent_id")
  level       Int       @default(1)
  
  // 业务字段
  code        String
  name        String
  description String?
  managerId   String?   @map("manager_id")
  
  // 状态
  status      Int       @default(1)
  isActive    Boolean   @default(true) @map("is_active")
  
  // 租户
  tenantId    String    @default("0") @map("tenant_id")
  
  // 关联
  teams       Team[]
  
  // 审计
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  version     Int       @default(1)
  
  // 扩展
  extJson     Json?     @map("ext_json")
  
  @@unique([tenantId, code])
  @@index([parentId])
  @@index([status])
  @@index([tenantId])
  @@index([managerId])
  @@map("departments")
}

// 团队表
model Team {
  id          String    @id @default(cuid())
  
  // 关联
  departmentId String?  @map("department_id")
  department  Department? @relation(fields: [departmentId], references: [id])
  
  // 业务字段
  name        String
  description String?
  leaderId    String?   @map("leader_id")
  maxMembers  Int       @default(10) @map("max_members")
  
  // 状态
  status      Int       @default(1)
  isActive    Boolean   @default(true) @map("is_active")
  
  // 租户
  tenantId    String    @default("0") @map("tenant_id")
  
  // 关联
  teamMembers TeamMember[]
  
  // 审计
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  version     Int       @default(1)
  
  // 扩展
  extJson     Json?     @map("ext_json")
  
  @@index([departmentId])
  @@index([status])
  @@index([tenantId])
  @@index([leaderId])
  @@map("teams")
}

// 团队成员表
model TeamMember {
  id          String    @id @default(cuid())
  
  // 关联
  teamId      String    @map("team_id")
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 团队内角色
  roleInTeam  String    @default("member") @map("role_in_team") // leader, member, guest
  
  // 状态
  status      Int       @default(1)
  isActive    Boolean   @default(true) @map("is_active")
  
  // 时间
  joinedAt    DateTime  @default(now()) @map("joined_at")
  
  // 审计
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  version     Int       @default(1)
  
  // 扩展
  extJson     Json?     @map("ext_json")
  
  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([status])
  @@map("team_members")
}

// ==================== 付费订阅套餐 ====================

// 订阅套餐表
model SubscriptionPlan {
  id          String    @id @default(cuid())
  
  // 业务字段
  code        String    @unique // free, pro, enterprise
  name        String
  description String?
  priceMonthly Decimal? @map("price_monthly")
  priceYearly  Decimal? @map("price_yearly")
  currency    String    @default("CNY")
  
  // 配额配置
  quotas      Json      @default("{\"api_calls_per_day\": 100, \"models_max\": 5, \"storage_mb\": 100, \"team_members_max\": 1, \"skills_max\": 10, \"agents_max\": 3}")
  features    Json?     @default("[]")
  sortOrder   Int       @default(0) @map("sort_order")
  
  // 状态
  status      Int       @default(1)
  isActive    Boolean   @default(true) @map("is_active")
  
  // 关联
  userQuotas  UserQuota[]
  
  // 审计
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  version     Int       @default(1)
  
  // 扩展
  extJson     Json?     @map("ext_json")
  
  @@index([code])
  @@index([status])
  @@index([isActive])
  @@map("subscription_plans")
}

// 用户配额表
model UserQuota {
  id          String    @id @default(cuid())
  
  // 关联
  userId      String    @unique @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  planId      String?   @map("plan_id")
  plan        SubscriptionPlan? @relation(fields: [planId], references: [id])
  
  // API调用配额
  apiCallsLimit   Int?    @map("api_calls_limit")
  apiCallsUsed    Int     @default(0) @map("api_calls_used")
  apiCallsResetAt DateTime? @map("api_calls_reset_at")
  
  // 存储配额
  storageLimitMb  Int?    @map("storage_limit_mb")
  storageUsedMb   Int     @default(0) @map("storage_used_mb")
  
  // 模型配额
  modelsLimit     Int?    @map("models_limit")
  modelsCreated   Int     @default(0) @map("models_created")
  
  // 团队配额
  teamMembersLimit Int?   @map("team_members_limit")
  teamMembersCount Int    @default(0) @map("team_members_count")
  
  // Skill配额
  skillsLimit     Int?    @map("skills_limit")
  skillsCreated   Int     @default(0) @map("skills_created")
  
  // Agent配额
  agentsLimit     Int?    @map("agents_limit")
  agentsCreated   Int     @default(0) @map("agents_created")
  
  // 额外配额包
  extraQuotas     Json?   @map("extra_quotas")
  
  // 状态
  status      Int       @default(1)
  isActive    Boolean   @default(true) @map("is_active")
  
  // 审计
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  version     Int       @default(1)
  
  // 扩展
  extJson     Json?     @map("ext_json")
  
  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("user_quotas")
}
