// ============================================
// Aidean 数据库 Schema - 52张表完整设计
// 基于4份数据库设计文档(opencode/trae/windsurf/workbuddy)整合
// ============================================

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // extensions = [pgcrypto, uuid_ossp, pg_trgm, ltree]  // 手动在SQL中创建
}

// ============================================
// 命名空间映射 (对应PGSQL Schema)
// aidean_core - 核心业务
// aidean_models - 模型与天梯图
// aidean_tools - 工具生态
// aidean_resources - 资源内容
// aidean_user - 用户行为
// aidean_system - 系统管理
// aidean_analytics - 统计分析
// ============================================

enum SchemaNamespace {
  CORE
  MODELS
  TOOLS
  RESOURCES
  USER
  SYSTEM
  ANALYTICS
}

// ==================== Core Schema: User & Auth ====================

// 用户主表 - aidean_core.users
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  nickname     String?
  avatar       String?
  role         UserRole      @default(USER)
  status       UserStatus    @default(ACTIVE)
  balance      Decimal       @default(0) @db.Decimal(19, 4)
  
  // 安全相关
  emailVerified Boolean     @default(false)
  lastLoginAt   DateTime?
  loginCount    Int         @default(0)
  failedLoginAttempts Int   @default(0)
  lockedUntil   DateTime?
  
  // 通用审计字段
  isActive     Boolean       @default(true)
  version      Int           @default(1)
  tenantId     String?       @map("tenant_id")
  orgId        String?       @map("org_id")
  
  // 扩展预留字段
  extJson      Json?         @map("ext_json")
  tags         String[]      @default([])
  attr01       String?       @map("attr_01")
  attr02       String?       @map("attr_02")
  
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  // 分身系统配置
  defaultPersonaId String?       @map("default_persona_id")
  autoExecuteEnabled Boolean     @default(false) @map("auto_execute_enabled")
  learningEnabled  Boolean       @default(true) @map("learning_enabled")
  
  // 关联
  profile      UserProfile?
  sessions     UserSession[]
  subscription Subscription?
  favorites    Favorite[]
  transactions Transaction[]
  rechargeOrders RechargeOrder[]
  evaluations  Evaluation[]
  apiKeys      ApiKey[]
  notifications UserNotification[]
  auditLogs    AuditLog[]
  
  // IDE/CLI分身系统关联
  personas     Persona[]
  conversations Conversation[]
  documents    Document[]
  tasks        Task[]
  taskNotifications TaskNotification[]
  toolRegistries ToolRegistry[]
  remoteChannels RemoteChannel[]
  learningSources LearningSource[]
  agentTeams   AgentTeam[]
  modelProviders ModelProvider[]
  notificationSettings NotificationSetting[]
  inboxNotifications InboxNotification[]
  feedback     Feedback[]
  feedbackComments FeedbackComment[]
  
  // 资源扩展关联
  collections  UserCollection[]
  priceAlerts  PriceAlert[]
  apiUsage     ModelApiUsage[]
  accessLogs   ResourceAccessLog[]
  
  // RBAC权限体系关联
  userRoleMappings    UserRoleMapping[]
  teamMembers  TeamMember[]
  userQuota    UserQuota?

  @@index([email])
  @@index([status])
  @@index([isActive])
  @@index([defaultPersonaId])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

// 用户扩展资料 - aidean_core.user_profiles
model UserProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  realName    String?   @map("real_name")
  phone       String?
  company     String?
  position    String?
  bio         String?
  website     String?
  github      String?
  wechat      String?
  
  preferences Json?     // 用户偏好设置
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("user_profiles")
}

// 用户会话 - aidean_core.user_sessions
model UserSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  token       String    @unique
  refreshToken String?
  
  deviceInfo  Json?     // 设备信息
  ipAddress   String?   @map("ip_address")
  
  expiresAt   DateTime  @map("expires_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("user_sessions")
}

// API Key管理 - aidean_core.api_keys
model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  keyId       String    @unique @map("key_id")
  name        String
  keyHash     String    @map("key_hash")
  
  permissions String[]  @default([])
  rateLimit   Json?     @map("rate_limit")
  
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

enum UserRole {
  GUEST        @map("0")
  USER         @map("1")
  VIP          @map("2")
  PREMIUM      @map("3")
  MODERATOR    @map("10")
  ADMIN        @map("99")
  SUPER_ADMIN  @map("100")
}

model Subscription {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SubscriptionType
  expiresAt DateTime
  createdAt DateTime         @default(now())
}

enum SubscriptionType {
  FREE
  MONTHLY
  YEARLY
}

// ==================== Models Schema: Vendor & AI Models ====================

// 厂商表 - aidean_models.vendors
model Vendor {
  id            String    @id @default(cuid())
  
  // 基础信息
  code          String    @unique  // 厂商代码：openai, anthropic, deepseek
  name          String             // 显示名称
  nameCn        String?   @map("name_cn")
  nameEn        String?   @map("name_en")
  
  // 品牌信息
  logoUrl       String?   @map("logo_url")
  brandColor    String?   @map("brand_color")
  website       String?
  
  // 厂商层级
  tierLevel     Int       @default(1) @map("tier_level")  // 1-5级
  isFeatured    Boolean   @default(false) @map("is_featured")
  
  // 公司信息
  companyName   String?   @map("company_name")
  country       String?
  foundedYear   Int?      @map("founded_year")
  
  // 描述
  description   String?
  descriptionCn String?   @map("description_cn")
  
  // 统计
  modelCount    Int       @default(0) @map("model_count")
  totalStars    Int       @default(0) @map("total_stars")
  
  // 通用字段
  isActive      Boolean   @default(true) @map("is_active")
  sortOrder     Int       @default(0) @map("sort_order")
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // 关联
  models        AiModel[]
  parentRelations VendorRelation[] @relation("ParentRelations")
  childRelations  VendorRelation[] @relation("ChildRelations")

  @@index([tierLevel])
  @@index([isFeatured])
  @@index([isActive])
  @@map("vendors")
}

// AI模型主表 - aidean_models.ai_models
model AiModel {
  id            String        @id @default(cuid())
  
  // 唯一标识
  modelCode     String        @unique @map("model_code")  // 如：gpt-4o, claude-3-opus
  nameDisplay   String        @map("name_display")       // 显示名称
  nameCn        String?       @map("name_cn")
  nameEn        String?       @map("name_en")
  slug          String        @unique                    // URL友好名称
  
  // 厂商关联
  vendorId      String        @map("vendor_id")
  vendor        Vendor        @relation(fields: [vendorId], references: [id])
  
  // 分类（支持多层级）
  modelType     ModelType     @map("model_type")
  categoryId    String?       @map("category_id")         // 专业/应用版
  
  // 技术参数
  parameterCount String?      @map("parameter_count")     // 如：591B, 70B
  contextLength  Int?         @map("context_length")     // 上下文长度
  maxOutputTokens Int?        @map("max_output_tokens")
  
  // 特性
  isOpenSource   Boolean      @default(false) @map("is_open_source")
  isMultiModal   Boolean      @default(false) @map("is_multi_modal")
  isReasoning    Boolean      @default(false) @map("is_reasoning")
  isCodingOptimized Boolean   @default(false) @map("is_coding_optimized")
  
  // 协议
  protocol      ModelProtocol  @default(OPENAI)
  
  // 链接
  officialUrl   String?        @map("official_url")
  docsUrl       String?        @map("docs_url")
  apiUrl        String?        @map("api_url")
  githubUrl     String?        @map("github_url")
  paperUrl      String?        @map("paper_url")
  
  // 发布信息
  publishedAt   DateTime?    @map("published_at")
  deprecatedAt  DateTime?    @map("deprecated_at")
  
  // 状态
  status        ModelStatus  @default(ACTIVE)
  visibility    Visibility   @default(PUBLIC)
  
  // 评分（冗余存储，方便查询）
  benchmarkScore Float?      @map("benchmark_score")
  popularityScore Float?     @map("popularity_score")
  
  // 通用字段
  isActive      Boolean      @default(true) @map("is_active")
  isFeatured    Boolean      @default(false) @map("is_featured")
  featuredWeight Int         @default(0) @map("featured_weight")
  sortOrder     Int          @default(0) @map("sort_order")
  version       Int          @default(1)
  tags          String[]     @default([])
  
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  // 关联
  prices        ModelPrice[]
  benchmarks    Benchmark[]
  scores        ModelScore[]
  rankings      LadderRanking[]
  evaluations   EvaluationModel[]
  
  // 变更历史与自定义指标
  changeLogs    ModelChangeLog[]
  metricValues  CustomMetricValue[]
  
  // 资源扩展
  versions      ModelVersion[]
  versionParent ModelVersion? @relation("VersionChain")
  priceAlerts   PriceAlert[]
  apiUsage      ModelApiUsage[]

  @@index([vendorId])
  @@index([modelType])
  @@index([modelCode])
  @@index([status])
  @@index([isActive])
  @@index([benchmarkScore])
  @@index([popularityScore])
  @@map("ai_models")
}

enum ModelType {
  CHAT          @map("1")    // 对话
  REASONING     @map("2")    // 推理
  MULTIMODAL    @map("3")    // 多模态
  CODE          @map("4")    // 代码
  VISION        @map("5")    // 视觉
  AUDIO         @map("6")    // 语音
  EMBEDDING     @map("7")    // 嵌入
  RERANK        @map("8")    // 排序
  ASR           @map("9")    // 语音识别
  TTS           @map("10")   // 语音合成
  IMAGE_GEN     @map("11")   // 图像生成
  VIDEO         @map("12")   // 视频
  SYSTEM        @map("13")   // 系统级
}

enum ModelProtocol {
  OPENAI        @map("1")
  ANTHROPIC     @map("2")
  GOOGLE        @map("3")
  CUSTOM        @map("4")
}

enum ModelStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
  BETA
}

enum Visibility {
  PUBLIC        @map("1")
  LOGIN_ONLY    @map("2")
  PAID_ONLY     @map("3")
  HIDDEN        @map("4")
}

// 模型价格历史 - aidean_models.model_prices
model ModelPrice {
  id              String    @id @default(cuid())
  modelId         String    @map("model_id")
  model           AiModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  // 价格（统一为 ¥/M Tokens）
  priceCache      Decimal?  @db.Decimal(19, 6) @map("price_cache")
  priceInput      Decimal   @db.Decimal(19, 6) @map("price_input")
  priceOutput     Decimal   @db.Decimal(19, 6) @map("price_output")
  pricePerRequest Decimal?  @db.Decimal(19, 6) @map("price_per_request")
  
  // 计费模式
  billingMode     BillingMode @default(PER_TOKEN) @map("billing_mode")
  billingCurrency String      @default("CNY") @map("billing_currency")
  
  // 原始价格记录
  originalCurrency String?  @map("original_currency")
  originalPriceInput Decimal? @db.Decimal(19, 6) @map("original_price_input")
  originalPriceOutput Decimal? @db.Decimal(19, 6) @map("original_price_output")
  exchangeRate    Decimal?    @db.Decimal(10, 6) @map("exchange_rate")
  
  // 生效时间（支持历史版本）
  effectiveFrom   DateTime    @map("effective_from")
  effectiveUntil  DateTime?   @map("effective_until")
  isCurrent       Boolean     @default(true) @map("is_current")
  
  // 来源
  sourceType    PriceSource @default(OFFICIAL) @map("source_type")
  sourceName    String?     @map("source_name")
  sourceUrl     String?     @map("source_url")
  
  notes         String?
  
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([modelId])
  @@index([isCurrent])
  @@index([effectiveFrom])
  @@map("model_prices")
}

enum BillingMode {
  PER_TOKEN     @map("1")
  PER_REQUEST   @map("2")
  PER_MINUTE    @map("3")
  FREE          @map("4")
}

enum PriceSource {
  OFFICIAL      @map("1")
  API_STATION   @map("2")
  USER_SUBMIT   @map("3")
  CRAWLER       @map("4")
}

// 模型综合评分 - aidean_models.model_scores
model ModelScore {
  id              String    @id @default(cuid())
  modelId         String    @map("model_id")
  model           AiModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  // 四维评分
  officialScore   Decimal?  @db.Decimal(5, 2) @map("official_score")
  actualScore     Decimal?  @db.Decimal(5, 2) @map("actual_score")
  reviewScore     Decimal?  @db.Decimal(5, 2) @map("review_score")
  selfTestScore   Decimal?  @db.Decimal(5, 2) @map("self_test_score")
  
  // 扩展维度
  reasoningScore  Decimal?  @db.Decimal(5, 2) @map("reasoning_score")
  codingScore     Decimal?  @db.Decimal(5, 2) @map("coding_score")
  mathScore       Decimal?  @db.Decimal(5, 2) @map("math_score")
  multilingualScore Decimal? @db.Decimal(5, 2) @map("multilingual_score")
  creativityScore Decimal?  @db.Decimal(5, 2) @map("creativity_score")
  instructionScore Decimal? @db.Decimal(5, 2) @map("instruction_score")
  safetyScore     Decimal?  @db.Decimal(5, 2) @map("safety_score")
  efficiencyScore Decimal?  @db.Decimal(5, 2) @map("efficiency_score")
  
  // 性价比
  valueScore      Decimal?  @db.Decimal(5, 2) @map("value_score")
  
  // 权重配置（记录计算时的权重）
  officialWeight  Decimal   @db.Decimal(4, 3) @default(0.25) @map("official_weight")
  actualWeight    Decimal   @db.Decimal(4, 3) @default(0.25) @map("actual_weight")
  reviewWeight    Decimal   @db.Decimal(4, 3) @default(0.25) @map("review_weight")
  selfTestWeight  Decimal   @db.Decimal(4, 3) @default(0.25) @map("self_test_weight")
  
  // 综合得分
  compositeScore  Decimal   @db.Decimal(5, 2) @map("composite_score")
  
  // 排名
  overallRank     Int?      @map("overall_rank")
  categoryRank    Int?      @map("category_rank")
  vendorRank      Int?      @map("vendor_rank")
  
  // 版本控制
  calcVersion     Int       @default(1) @map("calc_version")
  calcAt          DateTime  @default(now()) @map("calc_at")
  isCurrent       Boolean   @default(true) @map("is_current")
  
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([modelId, calcVersion])
  @@index([modelId])
  @@index([isCurrent])
  @@index([compositeScore])
  @@index([overallRank])
  @@map("model_scores")
}

// 基准测试 - aidean_models.model_benchmarks
model Benchmark {
  id              String    @id @default(cuid())
  modelId         String    @map("model_id")
  model           AiModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  // 测试来源
  sourceType      BenchmarkSource
  sourceName      String?   @map("source_name")
  sourceUrl       String?   @map("source_url")
  sourceVersion   String?   @map("source_version")
  
  // 测试类型
  benchmarkType   String    @map("benchmark_type")
  benchmarkSubType String?  @map("benchmark_sub_type")
  
  // 分数（JSON存储多维度）
  scores          Json
  totalScore      Decimal   @db.Decimal(5, 2) @map("total_score")
  scorePercentile Decimal?  @db.Decimal(5, 2) @map("score_percentile")
  
  // 测试详情
  testDate        DateTime? @map("test_date")
  testParams      Json?     @map("test_params")
  rawData         Json?     @map("raw_data")
  
  // 置信度
  confidenceLevel Decimal?  @db.Decimal(4, 3) @map("confidence_level")
  sampleCount     Int?      @map("sample_count")
  
  // 权重
  weight          Decimal   @db.Decimal(4, 3) @default(0.25)
  isWeighted      Boolean   @default(false) @map("is_weighted")
  
  // 验证状态
  verifiedStatus  Int       @default(0) @map("verified_status")
  
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([modelId])
  @@index([sourceType])
  @@index([benchmarkType])
  @@index([testDate])
  @@map("model_benchmarks")
}

enum BenchmarkSource {
  OFFICIAL      @map("1")
  ACTUAL        @map("2")
  REVIEW        @map("3")
  SELF          @map("4")
  THIRD_PARTY   @map("5")
}

enum ModelCategory {
  PROFESSIONAL
  APPLICATION
}

// ==================== Evaluation ====================

model Evaluation {
  id        String           @id @default(cuid())
  userId    String          @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 基本信息
  title     String?
  description String?       @map("description")
  prompt    String          @db.Text
  
  // 评测类型
  evalType  String          @default("single") @map("eval_type") // single | comparison | batch
  comparisonMode String?     @map("comparison_mode") // parallel | sequential | ab_test
  
  // 关联模型
  models    EvaluationModel[]
  
  // 评测配置
  config    Json?           @map("config") // 温度、最大token等参数
  criteria  Json?           @map("criteria") // 评分标准
  
  // 环境信息
  metadata  Json?           @map("metadata") // 评测环境、设备、网络等
  
  // 结果汇总
  results   Json?           @map("results") // 汇总统计
  winnerModelId String?     @map("winner_model_id") // 胜出模型
  
  // 状态控制
  status    EvalStatus       @default(PENDING) @map("status")
  progress  Int             @default(0) @map("progress") // 进度 0-100
  
  // 审计字段
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  @@index([userId])
  @@index([status])
  @@index([evalType])
  @@index([createdAt])
  @@map("evaluations")
}

model EvaluationModel {
  id             String      @id @default(cuid())
  evaluationId   String      @map("evaluation_id")
  evaluation     Evaluation  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  modelId        String      @map("model_id")
  model          AiModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  // 输出内容
  response       String?     @db.Text  // 最终输出
  thinking       String?     @db.Text  // 思考过程（reasoning模型的思维链）
  reasoningContent String?   @db.Text @map("reasoning_content") // 详细推理内容
  
  // Token用量（支持输入/输出/思考分离）
  tokensInput    Int?        @map("tokens_input")    // 输入tokens
  tokensOutput   Int?        @map("tokens_output")   // 输出tokens
  tokensThinking Int?        @map("tokens_thinking")  // 思考tokens
  tokensTotal    Int?        @map("tokens_total")     // 总计
  
  // 性能指标
  latency        Float?      @map("latency_ms")       // 响应时间 ms
  timeToFirstToken Float?    @map("ttft_ms")          // 首字延迟
  
  // 评分（支持多维度）
  score          Float?                              // 总分
  accuracyScore  Float?      @map("accuracy_score")  // 准确性
  relevanceScore Float?    @map("relevance_score") // 相关性
  coherenceScore Float?    @map("coherence_score") // 连贯性
  creativityScore Float?   @map("creativity_score") // 创造力
  
  // 原始响应（完整JSON）
  rawResponse    Json?       @map("raw_response")
  
  // 状态
  status         String      @default("completed") @map("status") // pending | running | completed | failed
  errorMessage   String?     @map("error_message")
  
  // 审计
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([evaluationId])
  @@index([modelId])
  @@index([status])
  @@map("evaluation_models")
}

enum EvalStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ==================== Skills ====================

model Skill {
  id           String    @id @default(cuid())
  name         String
  nameCn       String?
  displayName  String
  description  String
  author       String?
  authorUrl    String?
  version      String?
  category     String?
  tags         String[]
  protocol     String     @default("anthropic") // anthropic | openai | universal
  mcpServers   String[]   // 关联的 MCP 服务器
  downloads    Int        @default(0)
  stars        Int        @default(0)
  rating       Float?     // 平均评分
  reviewCount  Int        @default(0)
  lastUpdated  DateTime?
  icon         String?
  readmeUrl    String?
  installCmd   String?
  isVerified   Boolean    @default(false)
  isFeatured   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([downloads])
  @@index([stars])
  @@index([rating])
}

// ==================== MCP Servers ====================

model MCPServer {
  id           String    @id @default(cuid())
  name         String
  nameCn       String?
  displayName  String
  description  String
  author       String?
  authorUrl    String?
  version      String?
  category     String?
  tags         String[]
