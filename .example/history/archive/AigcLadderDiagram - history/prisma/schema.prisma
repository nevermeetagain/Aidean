// ==================== Ladder Charts ====================

// 天梯图定义 - aidean_models.ladder_charts
model LadderChart {
  id              String      @id @default(cuid())
  
  // 基础信息
  chartCode       String      @unique @map("chart_code")
  name            String
  nameCn          String?     @map("name_cn")
  nameEn          String?     @map("name_en")
  description     String?
  descriptionShort String?    @map("description_short")
  
  // 类型
  chartType       ChartType   @map("chart_type")
  
  // 适用模型类型
  applicableTypes ModelType[] @map("applicable_types")
  
  // 排序配置
  defaultSortKey  String      @default("composite_score") @map("default_sort_key")
  sortDirection   String      @default("DESC") @map("sort_direction")
  secondarySortKey String?    @map("secondary_sort_key")
  
  // 筛选配置
  defaultFilters  Json?       @map("default_filters")
  displayColumns  Json?       @map("display_columns")
  
  // 显示控制
  pageSize        Int         @default(50) @map("page_size")
  
  // 评分权重配置
  scoreWeights    Json?       @map("score_weights")
  
  // 可见性
  isPublic        Boolean     @default(true) @map("is_public")
  requiredRole    Int         @default(0) @map("required_role")
  
  // 状态
  isActive        Boolean     @default(true) @map("is_active")
  isFeatured      Boolean     @default(true) @map("is_featured")
  sortOrder       Int         @default(0) @map("sort_order")
  
  // 统计
  modelCount      Int         @default(0) @map("model_count")
  viewCount       Int         @default(0) @map("view_count")
  
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // 关联
  rankings        LadderRanking[]

  @@index([chartType])
  @@index([isActive])
  @@map("ladder_charts")
}

enum ChartType {
  PERFORMANCE   @map("1")   // 性能
  PRICE_VALUE   @map("2")   // 性价比
  OPEN_SOURCE   @map("3")   // 开源
  MOBILE        @map("4")   // 手机端
  CUSTOM        @map("5")   // 自定义
}

// 天梯图排名 - aidean_models.ladder_rankings
model LadderRanking {
  id              String      @id @default(cuid())
  
  chartId         String      @map("chart_id")
  chart           LadderChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  
  modelId         String      @map("model_id")
  model           AiModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  // 排名信息
  rankPosition    Int         @map("rank_position")
  previousRank    Int?        @map("previous_rank")
  rankChange      Int?        @map("rank_change")
  
  // 排序值
  sortValue       Decimal?    @db.Decimal(19, 4) @map("sort_value")
  secondaryValue  Decimal?    @db.Decimal(19, 4) @map("secondary_value")
  
  // 显示数据冗余
  modelCode       String      @map("model_code")
  modelName       String      @map("model_name")
  vendorName      String      @map("vendor_name")
  vendorColor     String?     @map("vendor_color")
  
  // 核心指标冗余
  compositeScore  Decimal?    @db.Decimal(5, 2) @map("composite_score")
  benchmarkScore  Decimal?    @db.Decimal(5, 2) @map("benchmark_score")
  contextLength   Int?        @map("context_length")
  priceInput      Decimal?    @db.Decimal(19, 6) @map("price_input")
  priceOutput     Decimal?    @db.Decimal(19, 6) @map("price_output")
  isOpenSource    Boolean     @default(false) @map("is_open_source")
  
  // 版本控制
  versionDate     DateTime    @default(now()) @map("version_date")
  versionSequence Int         @default(1) @map("version_sequence")
  
  // 状态控制
  status          String      @default("active") @map("status") // active | hidden | deprecated
  
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([chartId, modelId, versionDate, versionSequence])
  @@index([chartId, versionDate])
  @@index([modelId])
  @@index([rankPosition])
  @@map("ladder_rankings")
}

