model LadderRanking {
  id      String      @id @default(uuid(7))
  chartId String      @map("chart_id")
  chart   LadderChart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  modelId String  @map("model_id")
  model   AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  rankPosition Int  @map("rank_position")
  previousRank Int? @map("previous_rank")
  rankChange   Int? @map("rank_change")

  sortValue      Decimal? @map("sort_value") @db.Decimal(19, 4)
  secondaryValue Decimal? @map("secondary_value") @db.Decimal(19, 4)

  // 显示数据冗余
  modelCode   String  @map("model_code")
  modelName   String  @map("model_name")
  vendorName  String  @map("vendor_name")
  vendorColor String? @map("vendor_color")

  compositeScore Decimal? @map("composite_score") @db.Decimal(5, 2)
  benchmarkScore Decimal? @map("benchmark_score") @db.Decimal(5, 2)
  contextLength  Int?
  priceInput     Decimal? @map("price_input") @db.Decimal(19, 6)
  priceOutput    Decimal? @map("price_output") @db.Decimal(19, 6)
