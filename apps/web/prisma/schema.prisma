  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([chartId, modelId, versionDate, versionSequence])
  @@index([chartId, versionDate])
  @@index([modelId])
  @@index([rankPosition])
  @@map("ladder_rankings")
}

// ==================== 系统与配置 ====================

model FeatureFlag {
