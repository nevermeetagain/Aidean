enum ConfigType {
  STRING    @map("1")
  NUMBER    @map("2")
  BOOLEAN   @map("3")
  JSON      @map("4")
  RICH_TEXT @map("5")
}

model NavigationMenu {
  id       String  @id @default(uuid(7))
  menuCode String  @unique @map("menu_code")
  name     String
  nameEn   String? @map("name_en")

  parentId   String? @map("parent_id")
  parentCode String? @map("parent_code")
  level      Int     @default(1)
  path       String?

  linkType   LinkType @default(INTERNAL) @map("link_type")
  linkUrl    String?  @map("link_url")
  linkTarget String   @default("_self") @map("link_target")

  isDropdown   Boolean @default(false) @map("is_dropdown")
  isVisible    Boolean @default(true) @map("is_visible")
  showInHeader Boolean @default(true) @map("show_in_header")
  showInFooter Boolean @default(false) @map("show_in_footer")

  requireLogin  Boolean @default(false) @map("require_login")
  requiredRoles Int[]   @map("required_roles")

  i18nKey String? @map("i18n_key")

  badgeText  String? @map("badge_text")
  badgeColor String? @map("badge_color")
  highlight  Boolean @default(false)

  icon      String?
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  // 菜单作用域：SITE=前台导航（历史用途），ADMIN=管理端侧边栏（S2 激活）。
  // requiredPermissions：管理端可见性所需的 RBAC 权限码（S3 启用）；requiredRoles 保留作历史兼容。
  scope               NavScope @default(SITE)
  requiredPermissions String[] @default([]) @map("required_permissions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([isVisible])
  @@index([scope])
  @@map("navigation_menus")
}

enum LinkType {
  INTERNAL @map("1")
  EXTERNAL @map("2")
  DROPDOWN @map("3")
}

// 菜单作用域：区分前台导航与后台管理侧边栏（同一 navigation_menus 表服务两端）
enum NavScope {
  SITE
  ADMIN
}

// 站内通知
model UserNotification {
