}

// ==================================================================
// AI Market Discovery & Intelligence Engine（v1.0 新增）
// ------------------------------------------------------------------
// 依据: AI市场发现与智能引擎设计文档.md
// 架构: 6 层发现 → 智能生成 → 市场快照
// 设计: Candidate → Provider 渐进升级；证据链一等公民；多源不覆盖
// ==================================================================

/// 发现的候选实体（尚未验证为新平台/模型/工具）
model DiscoveryCandidate {
  id            String  @id @default(uuid(7))
  candidateType String  @map("candidate_type") // provider | gateway | model | tool
  name          String
  domain        String?
  apiBase       String? @map("api_base")
  description   String? @db.Text

  // 发现来源
  sourceType    String  @map("source_type") // registry | search | github | news | crawl
  sourceUrl     String  @map("source_url")
  sourceKeyword String? @map("source_keyword")

  // 状态机: discovered → verifying → verified → promoted / rejected
  status String @default("discovered")

  // 升级关联
  promotedToType String? @map("promoted_to_type") // ModelProvider | APIStation
  promotedToId   String? @map("promoted_to_id")

  // 技术指纹结果 (JSON)
  fingerprint Json?

  // 时间
  discoveredAt DateTime  @default(now()) @map("discovered_at")
  verifiedAt   DateTime? @map("verified_at")
  promotedAt   DateTime? @map("promoted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  evidence EvidenceChain[]

  @@index([status])
  @@index([domain])
  @@index([candidateType])
  @@index([sourceType])
  @@map("discovery_candidates")
}

/// 证据链：每个数据点的来源、置信度、时间戳
model EvidenceChain {
  id          String  @id @default(uuid(7))
  candidateId String? @map("candidate_id")
  providerId  String? @map("provider_id")
  modelId     String? @map("model_id")

  // 证据内容
  evidenceType String  @map("evidence_type") // discovery | fingerprint | protocol | pricing | quality | change
  claim        String  @db.Text
  source       String // official | aggregator | observed | search
  sourceUrl    String? @map("source_url")
  confidence   Float   @default(0.5)

  // 证据数据 (JSON)
  evidenceData Json? @map("evidence_data")

  collectedAt DateTime @default(now()) @map("collected_at")
  createdAt   DateTime @default(now()) @map("created_at")

  candidate DiscoveryCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([providerId])
  @@index([modelId])
  @@index([evidenceType])
  @@map("evidence_chains")
}

/// 协议兼容性：Provider/Station × Protocol 矩阵
model ProtocolCompatibility {
  id         String @id @default(uuid(7))
  entityType String @map("entity_type") // provider | station
  entityId   String @map("entity_id")

  // 协议
  protocol  String // openai_chat | openai_responses | anthropic_messages | streaming | tool_calling | structured_output | vision | audio | pdf | reasoning | mcp
  supported Boolean

  // 探测详情
  probeMethod String? @map("probe_method") // endpoint_check | minimal_request | documented
  probeResult Json?   @map("probe_result")
  confidence  Float   @default(0.5)

  probedAt  DateTime @default(now()) @map("probed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId, protocol])
  @@index([entityType, entityId])
  @@map("protocol_compatibilities")
}

/// 能力矩阵：Model × Capability
model CapabilityMatrix {
  id      String @id @default(uuid(7))
  modelId String @map("model_id")

  // 能力维度
  capability String // function_calling | vision | reasoning | structured_output | prompt_caching | code_execution | web_search | long_context
  supported  Boolean

  // 详情
  maxContextLength Int?  @map("max_context_length")
  detail           Json?

  // 来源
  source     String // official | benchmark | observed
  confidence Float  @default(0.5)

  detectedAt DateTime @default(now()) @map("detected_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([modelId, capability, source])
  @@index([modelId])
  @@map("capability_matrices")
}

/// 工具兼容性：Model × Tool (Claude Code / Cursor / Codex / ...)
model ToolCompatibility {
  id      String @id @default(uuid(7))
  modelId String @map("model_id")

  toolName   String  @map("tool_name") // claude_code | cursor | codex | opencode | cline | continue | aider
  compatible Boolean

  integrationType String? @map("integration_type") // native | api_compatible | plugin | unsupported
  setupGuide      String? @map("setup_guide") @db.Text

  verifiedAt DateTime @default(now()) @map("verified_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([modelId, toolName])
  @@index([modelId])
  @@map("tool_compatibilities")
}

/// 缓存策略：文档型缓存指标
model CachePolicy {
  id         String  @id @default(uuid(7))
  modelId    String? @map("model_id")
  providerId String? @map("provider_id")

  // 缓存类型
  cacheType String  @map("cache_type") // prompt_cache | response_cache | none
  supported Boolean

  // 文档型指标
  ttl             Int? // 秒
  minimumTokens   Int?   @map("minimum_tokens")
  cacheWritePrice Float? @map("cache_write_price") // per 1M tokens
  cacheReadPrice  Float? @map("cache_read_price")

  source String // official | observed

  documentedAt DateTime @default(now()) @map("documented_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([modelId])
  @@index([providerId])
  @@map("cache_policies")
}

/// 缓存实测：从实际请求观测的缓存指标
model CacheObservation {
  id       String  @id @default(uuid(7))
  modelId  String  @map("model_id")
  apiKeyId String? @map("api_key_id")

  // 实测指标
  eligibleTokens   Int    @map("eligible_tokens")
  cachedTokens     Int    @map("cached_tokens")
  cacheHitTokens   Int    @default(0) @map("cache_hit_tokens")
  cacheHitRequests Int    @default(0) @map("cache_hit_requests")
  latency          Float? // ms
  effectiveCost    Float? @map("effective_cost")

  // 计算指标
  cacheHitRate Float? @map("cache_hit_rate")

  observedAt DateTime @default(now()) @map("observed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([modelId])
  @@index([apiKeyId])
  @@map("cache_observations")
}

/// 速率限制策略
model RateLimitPolicy {
  id         String @id @default(uuid(7))
  entityType String @map("entity_type") // provider | station
  entityId   String @map("entity_id")

  // 限制
  rateLimitType String @map("rate_limit_type") // rpm | tpm | concurrent | daily
  limitValue    Int    @map("limit_value")
  windowSeconds Int    @map("window_seconds")

  source String // official | observed

  documentedAt DateTime @default(now()) @map("documented_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@map("rate_limit_policies")
}

/// 可靠性观测：延迟、可用性、错误率
model ReliabilityObservation {
  id         String @id @default(uuid(7))
  entityType String @map("entity_type") // provider | station
  entityId   String @map("entity_id")

  // 观测指标
  avgLatencyMs  Float? @map("avg_latency_ms")
  p99LatencyMs  Float? @map("p99_latency_ms")
  uptimePercent Float? @map("uptime_percent")
  errorRate     Float? @map("error_rate")
  successCount  Int    @default(0) @map("success_count")
  failureCount  Int    @default(0) @map("failure_count")

  // 观测窗口
  windowStart DateTime @map("window_start")
  windowEnd   DateTime @map("window_end")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([windowStart])
  @@map("reliability_observations")
}

/// 结构化价格规则：分层价格 + 多源证据
model PriceRule {
  id         String  @id @default(uuid(7))
  modelId    String? @map("model_id")
  providerId String? @map("provider_id")

  // 价格维度
  region    String? // us-east | cn-north | ...
  inputTier String? @map("input_tier") // 0-128k | 128k-200k | ...

  // 价格（per 1M tokens，单位：分）
  inputPriceMinor      BigInt? @map("input_price_minor")
  cacheReadPriceMinor  BigInt? @map("cache_read_price_minor")
  cacheWritePriceMinor BigInt? @map("cache_write_price_minor")
  outputPriceMinor     BigInt? @map("output_price_minor")
  batchPriceMinor      BigInt? @map("batch_price_minor")

  // 来源
  source    String // official | aggregator | observed
  sourceUrl String? @map("source_url")

  effectiveFrom DateTime? @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([modelId])
  @@index([providerId])
  @@index([source])
  @@map("price_rules")
}

/// 编码套餐：subscription / credit / window 等计费模型
model CodingPlan {
  id         String @id @default(uuid(7))
  entityType String @map("entity_type") // provider | station
  entityId   String @map("entity_id")

  planName String @map("plan_name")
  planType String @map("plan_type") // token_based | request_based | credit_based | window_based | hybrid

  // 价格（分）
  priceMinor BigInt? @map("price_minor")
  currency   String  @default("CNY")

  // 额度
  tokenLimit      Int? @map("token_limit")
  requestLimit    Int? @map("request_limit")
  windowDays      Int? @map("window_days")
  creditsIncluded Int? @map("credits_included")

  // 详情
  features  Json?
  sourceUrl String? @map("source_url")

  effectiveFrom DateTime? @map("effective_from")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@index([planType])
  @@map("coding_plans")
}

/// 市场快照：每日全量/增量快照 + diff
model MarketSnapshot {
  id           String   @id @default(uuid(7))
  snapshotDate DateTime @map("snapshot_date")
  snapshotType String   @map("snapshot_type") // full | incremental

  // 快照数据
  providerCount Int @map("provider_count")
  modelCount    Int @map("model_count")
  stationCount  Int @map("station_count")

  // JSON 数据
  data    Json
  diff    Json?
  summary Json?

  // 执行关联
  syncBatchId String? @map("sync_batch_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([snapshotDate])
  @@index([snapshotType])
  @@map("market_snapshots")
}
