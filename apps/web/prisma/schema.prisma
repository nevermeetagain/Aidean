  @@unique([modelId, benchmarkType, sourceType, testDate]) // D4 修复：防止重复同步累积重复 benchmark
  @@index([modelId])
  @@index([sourceType])
  @@index([benchmarkType])
  @@map("model_benchmarks")
}

enum BenchmarkSource {
  OFFICIAL    @map("1")
  ACTUAL      @map("2")
  REVIEW      @map("3")
  SELF        @map("4")
  THIRD_PARTY @map("5")
}

enum ModelCategory {
  PROFESSIONAL
  APPLICATION
}

// ==================== 模型站（大模型云服务天梯图）与统一计费网关 ====================

model APIStation {
  id           String    @id @default(uuid(7))
  name         String
  nameCn       String?   @map("name_cn")
  displayName  String    @map("display_name")
  description  String
  provider     String?
  website      String?
  apiDocs      String?   @map("api_docs")
  baseUrl      String?   @map("base_url")
  models       String[]
  protocols    String[]
  rateLimit    Json?     @map("rate_limit")
  pricing      Json?
  features     String[]
  useCase      String?   @map("use_case")
  avgLatency   Float?    @map("avg_latency")
  uptime       Float?
  activeUsers  Int       @default(0) @map("active_users")
  stars        Int       @default(0)
  rating       Float?
  reviewCount  Int       @default(0) @map("review_count")
  lastVerified DateTime? @map("last_verified")
  icon         String?
  isVerified   Boolean   @default(false) @map("is_verified")
  isFeatured   Boolean   @default(false) @map("is_featured")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  keys            StationKey[]
  billingRule     StationBillingRule?
  stationUserKeys StationUserKey[]
  packages        Package[]
  usageLogs       UsageLog[]

  @@index([avgLatency])
  @@index([uptime])
  @@index([activeUsers])
  @@map("api_stations")
}

// 平台 Key 池：每站多 Key 分流 / 并发，故障 Key 自动摘除
model StationKey {
  id        String     @id @default(uuid(7))
  stationId String     @map("station_id")
  station   APIStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  name          String? // Key 备注名
  keyValue      String           @map("key_value") // 加密存储
  weight        Int              @default(1) // 同层分流权重
  status        StationKeyStatus @default(ACTIVE)
  failureCount  Int              @default(0) @map("failure_count")
  cooldownUntil DateTime?        @map("cooldown_until")
  lastUsedAt    DateTime?        @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([stationId, keyValue])
  @@index([stationId])
  @@index([status])
  @@map("station_keys")
}

enum StationKeyStatus {
  ACTIVE   @map("1")
  DISABLED @map("2")
  COOLDOWN @map("3")
}

// 用户自有上游 Key（GW-KEY-01 P3-S3.1）：UPSTREAM 计费路径的用户侧凭据，userId+stationId 唯一。
// 密钥 AES-256-GCM 密文落库（keyCipher，JWT_SECRET 派生密钥）；界面/日志仅见 keyMasked 脱敏列，
// 解密只发生在网关调上游前（gateway/service.ts UPSTREAM 分支），列表/日志/UI 永不出明文。
model StationUserKey {
  id        String     @id @default(uuid(7))
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationId String     @map("station_id")
  station   APIStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  name      String? // 备注名
  keyCipher String  @map("key_cipher") // AES-256-GCM 密文（v1:iv:tag:ct，base64url）
  keyMasked String  @map("key_masked") // 脱敏展示（maskApiKey 口径）
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, stationId])
  @@index([userId])
  @@index([stationId])
  @@map("station_user_keys")
}

// 计费规则（每站一条）
// ⚠️ 敏感：markupRate / tokenMultiplier 仅经 /api/v1/admin/* 读写，
// 任何面向用户的接口不得返回（余额扣费 = 上游单价×加价率 × Token数×倍率）
model StationBillingRule {
  id        String     @id @default(uuid(7))
  stationId String     @unique @map("station_id")
  station   APIStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  billingMode     BillingModeRule @default(PLATFORM) @map("billing_mode")
  markupRate      Decimal         @default(1.000) @map("markup_rate") @db.Decimal(6, 3) // 平台加价率，默认 1.0
  tokenMultiplier Decimal         @default(1.000) @map("token_multiplier") @db.Decimal(6, 3) // Token 倍率，默认 1.0

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("station_billing_rules")
}

enum BillingModeRule {
  PLATFORM @map("1") // 本系统计费（默认）
  UPSTREAM @map("2") // 以模型服务平台为准
}

// 用户等级映射：用户将具体模型绑定至 Opus/Sonnet/Fable/Haiku 档
model UserTierMapping {
  id        String         @id @default(uuid(7))
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierLevel ModelTierLevel @map("tier_level")
  modelId   String         @map("model_id")
  model     AiModel        @relation(fields: [modelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, tierLevel, modelId])
  @@index([userId])
  @@map("user_tier_mappings")
}

// 模型等级（固定序 Opus > Sonnet > Fable > Haiku；映射由用户定义）
enum ModelTierLevel {
  OPUS   @map("1")
  SONNET @map("2")
  FABLE  @map("3")
  HAIKU  @map("4")
}

// 用户优先级配置（通用版/专业版共享底层路由配置）
model UserModelPriority {
  id       String  @id @default(uuid(7))
  userId   String  @map("user_id")
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId  String  @map("model_id")
  model    AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  priority Int     @default(50) // 1-99，1 最高；free 模型自动加载为最低优先级
  enabled  Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, modelId])
  @@index([userId])
  @@map("user_model_priorities")
}

// Free 等级默认免费模型及额度（后台定义，控制台自动加载，只读）
model UserFreeQuota {
  id           String       @id @default(uuid(7))
  tier         AccountTier
  modelId      String       @map("model_id")
  model        AiModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  quotaTokens  Int          @map("quota_tokens")
  refreshCycle RefreshCycle @map("refresh_cycle")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tier, modelId])
  @@map("user_free_quotas")
}

enum RefreshCycle {
  DAY   @map("1")
  WEEK  @map("2")
  MONTH @map("3")
}

// 免费额度用量（按周期刷新）
model UserQuotaUsage {
  id          String   @id @default(uuid(7))
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId     String   @map("model_id")
  model       AiModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  used        Int      @default(0)
  periodStart DateTime @map("period_start")

  @@unique([userId, modelId, periodStart])
  @@index([userId])
  @@map("user_quota_usages")
}

// 用户自定义平台渠道（自填 base_url + Key；不扣余额，无限制免费中转）
model CustomChannel {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  baseUrl       String        @map("base_url")
  keyCipher     String        @map("key_cipher") // AES-256-GCM 密文（v1:iv:tag:ct，base64url；crypto.ts encryptSecret）
  keyMasked     String        @map("key_masked") // 脱敏展示（maskApiKey 口径，落库冗余避免读侧重复计算）
  format        ChannelFormat @default(OPENAI)
  defaultParams Json?         @map("default_params")

  isActive   Boolean   @default(true) @map("is_active")
  lastTestAt DateTime? @map("last_test_at")
  lastTestOk Boolean?  @map("last_test_ok")

  // 调度增强（控制台 MVP）：适用模型白名单 / 优先级 / 分组标签 / 加权（并发分摊）
  models     String[]  @default([])
  priority   Int       @default(100)
  groupName  String?   @map("group_name")
  weight     Int       @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId])
  @@map("custom_channels")
}

enum ChannelFormat {
  OPENAI           @map("1")
  ANTHROPIC        @map("2")
  OPENAI_RESPONSES @map("3")
  GEMINI           @map("4")
}

// 网关用量明细（大表：实施期以 raw SQL 转 PARTITION BY RANGE(created_at)）
// 幂等：requestId 全局唯一；计费路径记录该请求走了哪条规则
model UsageLog {
  id        String @id @default(uuid(7))
  requestId String @unique @map("request_id")
  userId    String @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  modelId   String?     @map("model_id")
  stationId String?     @map("station_id")
  station   APIStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  channelId String?     @map("channel_id") // CustomChannel id（免费纯代理）
  model     String
  provider  String?

  promptTokens     Int @default(0) @map("prompt_tokens")
  completionTokens Int @default(0) @map("completion_tokens")
  cachedTokens     Int @default(0) @map("cached_tokens")
  reasoningTokens  Int @default(0) @map("reasoning_tokens")

  quotaMinor  BigInt           @default(0) @map("quota_minor") // 折算费用（分）
  billingPath UsageBillingPath @default(PLATFORM) @map("billing_path")
  latencyMs   Int?             @map("latency_ms")
  statusCode  Int?             @map("status_code")
  isStream    Boolean          @default(false) @map("is_stream")
  error       String?
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([stationId, createdAt])
  @@index([model, createdAt])
  @@map("usage_logs")
}

enum UsageBillingPath {
  PLATFORM   @map("1") // 本系统计费
  UPSTREAM   @map("2") // 上游计费（用户自有 Key）
  PACKAGE    @map("3") // 套餐直连
  FREE_PROXY @map("4") // 自定义渠道免费纯代理
  FREE_QUOTA @map("5") // 免费额度
}

// 用量日汇总（报表层，避免扫明细）
model UsageDailyStat {
  id     String   @id @default(uuid(7))
  day    DateTime @db.Date
  userId String   @map("user_id")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model  String

  requestCount     Int    @default(0) @map("request_count")
  quotaMinor       BigInt @default(0) @map("quota_minor")
  promptTokens     Int    @default(0) @map("prompt_tokens")
  completionTokens Int    @default(0) @map("completion_tokens")

  @@unique([day, userId, model])
  @@index([userId, day])
  @@map("usage_daily_stats")
}

// ==================== 计费账本（三表分离） ====================

// 余额账户（状态表；乐观锁并发控制）
model Wallet {
  id     String @id @default(uuid(7))
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currency           String @default("CNY")
  balanceMinor       BigInt @default(0) @map("balance_minor") // 余额（分）
  heldMinor          BigInt @default(0) @map("held_minor") // 预扣冻结（分）
  postedDebitsMinor  BigInt @default(0) @map("posted_debits_minor") // 累计支出（对账用）
  postedCreditsMinor BigInt @default(0) @map("posted_credits_minor") // 累计入账（对账用）

  status      WalletStatus @default(ACTIVE)
  lockVersion Int          @default(1) @map("lock_version") // 乐观锁

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries LedgerEntry[]
  holds   BalanceHold[]

  @@map("wallets")
}

enum WalletStatus {
  ACTIVE @map("1")
  FROZEN @map("2")
  CLOSED @map("3")
}

// 不可变流水（双录：一笔事务借贷两条；只允许 INSERT，纠错写反向冲正）
model LedgerEntry {
  id       String @id @default(uuid(7))
  txnId    String @map("txn_id") // 同一事务的借贷两条共享
  walletId String @map("wallet_id")
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  direction   LedgerDirection
  amountMinor BigInt            @map("amount_minor") // 恒为正
  entryType   LedgerEntryType
  status      LedgerEntryStatus @default(SETTLED)

  sourceType     String? @map("source_type") // recharge_order / usage_log / package_order / redemption / admin
  sourceId       String? @map("source_id")
  idempotencyKey String  @map("idempotency_key")

  effectiveAt DateTime @map("effective_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([walletId, idempotencyKey]) // 幂等兜底
  @@unique([txnId, direction])
  @@index([walletId, createdAt])
  @@index([txnId])
  @@map("ledger_entries")
}

enum LedgerDirection {
  DEBIT  @map("1") // 支出
  CREDIT @map("2") // 入账
}

enum LedgerEntryType {
  TOPUP    @map("1") // 充值
  CONSUME  @map("2") // 消费扣费
  REFUND   @map("3") // 退款
  REVERSAL @map("4") // 冲正
  GRANT    @map("5") // 赠送/兑换码入账
  EXPIRE   @map("6") // 过期
  ADJUST   @map("7") // 后台调整
}

enum LedgerEntryStatus {
  PENDING @map("1")
  SETTLED @map("2")
  FAILED  @map("3")
  VOIDED  @map("4")
}

// 预扣费持有（hold → capture；超时自动释放）
model BalanceHold {
  id        String @id @default(uuid(7))
  requestId String @unique @map("request_id") // 幂等键
  walletId  String @map("wallet_id")
  wallet    Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amountMinor   BigInt     @default(0) @map("amount_minor")
  capturedMinor BigInt     @default(0) @map("captured_minor")
  status        HoldStatus @default(AUTHORIZED)
  expiresAt     DateTime   @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([walletId])
  @@index([status, expiresAt])
  @@map("balance_holds")
}

enum HoldStatus {
  AUTHORIZED @map("1")
  CAPTURED   @map("2")
  VOIDED     @map("3")
  EXPIRED    @map("4")
}

// 充值订单（金额整数分）
model RechargeOrder {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amountMinor      BigInt      @map("amount_minor")
  bonusAmountMinor BigInt      @default(0) @map("bonus_amount_minor")
  totalAmountMinor BigInt      @map("total_amount_minor")
  payMethod        PayMethod   @map("pay_method")
  status           OrderStatus @default(PENDING)
  externalTradeNo  String?     @map("external_trade_no") // 第三方交易号
  paidAt           DateTime?   @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("recharge_orders")
}

enum PayMethod {
  WECHAT
  ALIPAY
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

// ==================== 套餐与兑换码 ====================

// 平台套餐（平台内权益；stationId 为空表示平台通用套餐）
model Package {
  id        String      @id @default(uuid(7))
  stationId String?     @map("station_id")
  station   APIStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  title         String
  description   String?
  priceMinor    BigInt        @map("price_minor") // 兑换价（分）
  durationHours Int?          @map("duration_hours") // 天卡=24
  benefits      Json? // 权益内容
  status        PackageStatus @default(ACTIVE)
  sortOrder     Int           @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  orders      PackageOrder[]
  redemptions Redemption[]

  @@index([stationId])
  @@map("packages")
}

enum PackageStatus {
  ACTIVE   @map("1")
  DISABLED @map("2")
}

// 套餐兑换订单（兑换后该平台请求按套餐直连计费）
model PackageOrder {
  id        String  @id @default(uuid(7))
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String  @map("package_id")
  package   Package @relation(fields: [packageId], references: [id])

  status     PackageOrderStatus @default(ACTIVE)
  redeemedAt DateTime           @default(now()) @map("redeemed_at")
  expiresAt  DateTime?          @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([packageId])
  @@map("package_orders")
}

enum PackageOrderStatus {
  PENDING   @map("1")
  ACTIVE    @map("2")
  EXPIRED   @map("3")
  CANCELLED @map("4")
}

// 兑换码（同一实体 + 目标约束：余额码 / 定向套餐码）
// 核销须单事务行锁 + 状态机（参照 one-api：SELECT FOR UPDATE → 校验 → 入账 → 置 USED）
model Redemption {
  id           String           @id @default(uuid(7))
  code         String           @unique
  targetType   RedemptionTarget @map("target_type")
  balanceMinor BigInt?          @map("balance_minor") // 余额码面额（分）
  packageId    String?          @map("package_id") // 定向套餐码绑定的套餐
  package      Package?         @relation(fields: [packageId], references: [id])

  name      String?
  batchNo   String?          @map("batch_no")
  status    RedemptionStatus @default(ENABLED)
  expiresAt DateTime?        @map("expires_at")

  redeemedBy String?   @map("redeemed_by")
  redeemer   User?     @relation(fields: [redeemedBy], references: [id])
  redeemedAt DateTime? @map("redeemed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([batchNo])
  @@index([status])
  @@map("redemptions")
}

enum RedemptionTarget {
  BALANCE @map("1")
  PACKAGE @map("2")
}

enum RedemptionStatus {
  ENABLED  @map("1")
  ISSUED   @map("5") // 已出库未售（卡商 Partner API 取码后置此态）
  USED     @map("2")
  DISABLED @map("3")
  EXPIRED  @map("4")
}

// 产品矩阵（前台 /products 读库渲染 + /products/[slug] 统一模板介绍页）
// intro（add-subplatform-showcase-pages）：v1 结构化介绍块 {version:1, links:[{label,url,kind}], facts:[{group,items:[{label,value}]}]}；
// 写侧经 @aidean/shared ProductIntroSchema 强校验。wechatrag slug ↔ 显示名 AideanBot 映射登记于该 spec。
model Product {
  id          String           @id @default(uuid(7))
  slug        String           @unique
  name        String
  // #71 产品中文命名与二级分类：displayName=中文显示名（空则显示层回退 name）；
  // category=产品下拉/列表页二级分组（null=未分类，归「其它」组）。口径真源见 docs/术语表.md 产品中文名映射。
  displayName String?          @map("display_name")
  category    ProductCategory?
  tagline     String?
  description String?          @db.Text
  badge       String?
  benefits    Json?
  intro       Json?
  status      ProductStatus    @default(ACTIVE)
  sortOrder   Int              @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("products")
}

enum ProductStatus {
  ACTIVE   @map("1")
  DISABLED @map("2")
}

// #71 产品二级分类。组序契约：OFFERING(特供) → OPEN_SOURCE(开源) → PARTNER(合作) → null(其它)；
// 展示文案唯一映射 apps/web/lib/product-label.ts PRODUCT_CATEGORY_LABELS。
enum ProductCategory {
  OFFERING    @map("1")
  OPEN_SOURCE @map("2")
  PARTNER     @map("3")
}

// ==================== 资讯（news-admin-cms） ====================

// 站内资讯：正文只存 Markdown，渲染在 SSR 端完成（markdown.ts 净化后输出 HTML）。
// pinned=true 恒置顶；后台删除即硬删（写审计），不做软删。
model NewsItem {
  id              String     @id @default(uuid(7))
  slug            String     @unique
  title           String
  summary         String     @default("")
  category        String
  contentMarkdown String     @map("content_markdown") @db.Text
  pinned          Boolean    @default(false)
  status          NewsStatus @default(DRAFT)
  publishedAt     DateTime?  @map("published_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@index([status, pinned, publishedAt(sort: Desc)])
  @@map("news_items")
}

enum NewsStatus {
  DRAFT     @map("0")
  PUBLISHED @map("1")
}

// 卡商平台密钥（明文仅创建时一次性返回，库内只存 SHA-256；prefix 8 位明文前缀供展示辨认）
model PartnerKey {
  id         String    @id @default(uuid(7))
  name       String
  keyHash    String    @unique @map("key_hash")
  prefix     String
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("partner_keys")
}

// ==================== 收藏 ====================

model Favorite {
  id        String       @id @default(uuid(7))
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  refType   FavoriteType
  refId     String       @map("ref_id")
  note      String?
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([userId, refType, refId])
  @@index([userId])
  @@index([refType, refId])
  @@map("favorites")
}

enum FavoriteType {
  MODEL
  API_STATION
}

// ==================== 测评 ====================

model Evaluation {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String?
  description String? @db.Text
  prompt      String  @db.Text

  evalType       String  @default("single") @map("eval_type") // single, comparison, batch
  comparisonMode String? @map("comparison_mode")

  config        Json    @default("{}")
  criteria      Json    @default("{}")
  metadata      Json?
  results       Json?
  winnerModelId String? @map("winner_model_id")

  status      Int       @default(0) // 0:待执行 1:执行中 2:已完成 3:失败
  progress    Int       @default(0)
  isPaid      Boolean   @default(false) @map("is_paid")
  cost        Decimal   @default(0) @map("cost") // 展示用；扣费走账本
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
