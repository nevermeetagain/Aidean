  selfTestScore Decimal? @map("self_test_score") @db.Decimal(5, 2)

  // R-34 扩展维度评分（已集成到 composite 计算，默认权重 0 = 禁用，管理员可通过权重管理 UI 启用）
  reasoningScore    Decimal? @map("reasoning_score") @db.Decimal(5, 2)
  codingScore       Decimal? @map("coding_score") @db.Decimal(5, 2)
  mathScore         Decimal? @map("math_score") @db.Decimal(5, 2)
  multilingualScore Decimal? @map("multilingual_score") @db.Decimal(5, 2)
  creativityScore   Decimal? @map("creativity_score") @db.Decimal(5, 2)
  instructionScore  Decimal? @map("instruction_score") @db.Decimal(5, 2)
  safetyScore       Decimal? @map("safety_score") @db.Decimal(5, 2)
  efficiencyScore   Decimal? @map("efficiency_score") @db.Decimal(5, 2)
  valueScore        Decimal? @map("value_score") @db.Decimal(5, 2)

  officialWeight     Decimal @default(0.25) @map("official_weight") @db.Decimal(4, 3)
  actualWeight       Decimal @default(0.25) @map("actual_weight") @db.Decimal(4, 3)
  reviewWeight       Decimal @default(0.25) @map("review_weight") @db.Decimal(4, 3)
  selfTestWeight     Decimal @default(0.25) @map("self_test_weight") @db.Decimal(4, 3)
  reasoningWeight    Decimal @default(0) @map("reasoning_weight") @db.Decimal(4, 3)
  codingWeight       Decimal @default(0) @map("coding_weight") @db.Decimal(4, 3)
  mathWeight         Decimal @default(0) @map("math_weight") @db.Decimal(4, 3)
  multilingualWeight Decimal @default(0) @map("multilingual_weight") @db.Decimal(4, 3)
  creativityWeight   Decimal @default(0) @map("creativity_weight") @db.Decimal(4, 3)
  instructionWeight  Decimal @default(0) @map("instruction_weight") @db.Decimal(4, 3)
  safetyWeight       Decimal @default(0) @map("safety_weight") @db.Decimal(4, 3)
  efficiencyWeight   Decimal @default(0) @map("efficiency_weight") @db.Decimal(4, 3)
  valueWeight        Decimal @default(0) @map("value_weight") @db.Decimal(4, 3)

  compositeScore Decimal @map("composite_score") @db.Decimal(5, 2)

  overallRank  Int? @map("overall_rank")
  categoryRank Int? @map("category_rank")
  vendorRank   Int? @map("vendor_rank")

  calcVersion Int      @default(1) @map("calc_version")
  calcAt      DateTime @default(now()) @map("calc_at")
  isCurrent   Boolean  @default(true) @map("is_current")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([modelId, calcVersion])
  @@index([modelId])
  @@index([isCurrent])
  @@index([compositeScore])
  @@map("model_scores")
}

// 基准测试
model Benchmark {
  id      String  @id @default(uuid(7))
  modelId String  @map("model_id")
  model   AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  sourceType    BenchmarkSource
  sourceName    String?         @map("source_name")
  sourceUrl     String?         @map("source_url")
  sourceVersion String?         @map("source_version")

  benchmarkType    String  @map("benchmark_type")
  benchmarkSubType String? @map("benchmark_sub_type")

  scores          Json
  totalScore      Decimal  @map("total_score") @db.Decimal(5, 2)
  scorePercentile Decimal? @map("score_percentile") @db.Decimal(5, 2)

  testDate   DateTime? @map("test_date")
  testParams Json?     @map("test_params")
  rawData    Json?     @map("raw_data")

  confidenceLevel Decimal? @map("confidence_level") @db.Decimal(4, 3)
  sampleCount     Int?

  weight     Decimal @default(0.25) @db.Decimal(4, 3)
  isWeighted Boolean @default(false) @map("is_weighted")

  verifiedStatus Int @default(0) @map("verified_status")

