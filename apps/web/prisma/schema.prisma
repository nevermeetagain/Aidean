}

model EvaluationModel {
  id           String     @id @default(uuid(7))
  evaluationId String     @map("evaluation_id")
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  modelId String  @map("model_id")
  model   AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  response         String? @db.Text
  thinking         String? @db.Text
  reasoningContent String? @map("reasoning_content") @db.Text

  tokensInput    Int @default(0) @map("tokens_input")
  tokensOutput   Int @default(0) @map("tokens_output")
  tokensThinking Int @default(0) @map("tokens_thinking")
  tokensTotal    Int @default(0) @map("tokens_total")

  latencyMs Int? @map("latency_ms")
  ttftMs    Int? @map("ttft_ms")

  score           Float?
  accuracyScore   Float? @map("accuracy_score")
  relevanceScore  Float? @map("relevance_score")
  coherenceScore  Float? @map("coherence_score")
  creativityScore Float? @map("creativity_score")

  rawResponse  Json?   @map("raw_response")
  status       String  @default("completed")
  errorMessage String? @map("error_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([evaluationId, modelId])
  @@index([evaluationId])
  @@index([modelId])
  @@map("evaluation_models")
}

// ==================== 排名与天梯图 ====================

model RankingWeight {
  id          String  @id @default(uuid(7))
  dimension   String  @unique // official | actual | review | self
  weight      Float   @default(25) // 0-100
