  name        String
  nameCn      String? @map("name_cn")
  description String?

  isEnabled    Boolean @default(false) @map("is_enabled")
  enabledRoles Int[]   @map("enabled_roles")

  rolloutPercentage Int    @default(100) @map("rollout_percentage")
  rolloutStrategy   String @default("all") @map("rollout_strategy")

  config Json?

  enableFrom  DateTime? @map("enable_from")
  enableUntil DateTime? @map("enable_until")

  category String?
  priority Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isEnabled])
  @@index([category])
  @@map("feature_flags")
}

model SystemConfig {
  id          String @id @default(uuid(7))
  configKey   String @unique @map("config_key")
  configGroup String @map("config_group")

  configType    ConfigType @default(STRING) @map("config_type")
  configValue   String     @map("config_value")
  configValueEn String?    @map("config_value_en")

