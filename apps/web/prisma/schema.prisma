// ==================================================================
// Aidean 主平台数据模型（v2.0 重建版）
// ------------------------------------------------------------------
// 版本: v2.0 | 更新: 2026-08-26 | 变更: 依据联网调研（账本/网关/审计/
//   UUIDv7 最佳实践）整体重建；删除 Agent/IDE 遗留 16 表、RBAC 9 表、
//   已废弃工具生态 4 表及全部重复/无引用表；落地统一计费网关与账本三表。
//
// 设计规范（调研结论，勿回退）：
//   1. 主键统一 UUIDv7（@default(uuid(7))，应用层生成，PG16 兼容）。
//   2. 金额一律整数最小单位（分）BigInt 字段 *Minor，禁止 Float/Decimal 存余额。
//   3. 账本三表分离：wallets（状态）/ ledger_entries（不可变双录流水）/
//      balance_holds（预扣）；流水表禁止 UPDATE/DELETE 与软删除。
//   4. 幂等：ledger_entries(walletId, idempotencyKey) 唯一；
//      balance_holds.requestId 唯一；usage_logs.requestId 唯一。
//   5. 乐观锁：仅可变状态表（wallets）使用 lockVersion。
//   6. 软删除 deletedAt 仅用于内容/配置类表；流水/日志/账本表禁用。
//   7. usage_logs 为大表：实施期以 raw SQL 迁移为 PARTITION BY
//      RANGE(created_at)（分区键须入主键），聚合查询走 usage_daily_stats。
//   8. 敏感字段：station_billing_rules.markupRate / tokenMultiplier 为
//      后台敏感配置，任何公开接口不得返回（序列化白名单控制）。
//
// 已删除模型（git 可追溯，需要时从历史恢复）：
//   Agent/IDE 遗留: Persona, LearningSource, Conversation, Document, Task,
//     TaskStep, TaskRollback, ToolRegistry, ToolExecution, RemoteChannel,
//     RemoteCommand, DocTemplate, UserTemplate, TaskArtifact,
//     TaskNotification, AgentTeam
//   RBAC 域: Role, Permission, UserRoleMapping, RolePermission, Department,
//     Team, TeamMember, SubscriptionPlan, UserQuota
//   已废弃生态: Skill, MCPServer, Agent, Newsync
//   重复/无引用: UserCollection(并入 Favorite), ModelProvider(演进为
//     CustomChannel), Transaction(被 LedgerEntry 替代), ModelApiUsage(被
//     UsageLog 替代), OperationLog(并入 AuditLog), UserSession, Subscription,
//     DictType, DictItem, Tag, ResourceTag, ResourceAccessLog, PriceAlert,
//     ModelVersion, VendorRelation, CustomMetric, CustomMetricValue,
//     InboxNotification, NotificationSetting, SystemMetric, ApiDocument,
//     BackupRecord, DataImport
// ==================================================================

generator client {
  provider        = "prisma-client-js"
  // Prisma 6：fullTextSearch 已更名为 fullTextSearchPostgres（v6 起 deprecation，下一大版本硬失败）
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // 扩展由 docker/sql/init/00_extensions.sql 创建：pgcrypto / uuid-ossp / pg_trgm / btree_gin
}

// ==================== 用户与认证 ====================

model User {
  id           String  @id @default(uuid(7))
  email        String  @unique
  password     String
  wechatOpenid String? @unique @map("wechat_openid") // 微信扫码登录
  nickname     String?
  avatar       String?

  role   UserRole    @default(USER)
  status UserStatus  @default(ACTIVE)
  tier   AccountTier @default(NORMAL) // 用户等级：普通 / Pro / Max

  // 安全
  emailVerified       Boolean   @default(false) @map("email_verified")
  lastLoginAt         DateTime? @map("last_login_at")
  loginCount          Int       @default(0) @map("login_count")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  // M-SSO P0.4：全端失效代际。改密/封号 ver++ 后，携带旧 ver 的 access/refresh 一律拒绝
  tokenVersion        Int       @default(0) @map("token_version")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // 关联
  profile          UserProfile?
  wallet           Wallet?
  apiKeys          ApiKey[]
  stationUserKeys  StationUserKey[]
  favorites        Favorite[]
  rechargeOrders   RechargeOrder[]
  evaluations      Evaluation[]
  notifications    UserNotification[]
  feedback         Feedback[]
  feedbackComments FeedbackComment[]
  customChannels   CustomChannel[]
  tierMappings     UserTierMapping[]
  modelPriorities  UserModelPriority[]
  quotaUsages      UserQuotaUsage[]
  usageLogs        UsageLog[]
  usageDailyStats  UsageDailyStat[]
  packageOrders    PackageOrder[]
  redemptions      Redemption[]
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]
  oidcConsents     OidcUserConsent[]
  roleAssignments  UserRoleAssignment[]

  @@index([status])
  @@index([tier])
  @@map("users")
}

// ==================================================================
// S3 RBAC（restructure-admin-nav-rbac-cms · A2 接口级权限 + B2 独立角色实体）
// 口径：User.role 枚举（SUPER_ADMIN/ADMIN）保留为「入场总闸」与向后兼容；
//       细粒度授权走 用户↔角色↔权限 多对多。SUPER_ADMIN 解析为通配 `*`（绕过逐接口校验）。
// ==================================================================

/// 角色（B2 独立实体）。code 为稳定键（与 shared 权限注册表 SYSTEM_ROLES 对齐）。
model Role {
  id          String   @id @default(uuid(7))
  code        String   @unique
  name        String
  description String?
  /// 系统内置角色（SUPER_ADMIN/ADMIN/MODERATOR）：禁删，权限集由 seed 收敛
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRoleAssignment[]

  @@map("roles")
}

/// 权限原子。code 形如 admin.<域>.<read|write>；`*` 为 SUPER_ADMIN 通配（不落库，解析层注入）。
model Permission {
  id          String   @id @default(uuid(7))
  code        String   @unique
  description String?
  domain      String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

/// 角色↔权限 连接表（多对多）。
model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

/// 用户↔角色 连接表（多对多，B2）。授权变更后 revalidateTag("admin-auth") 令守卫即时生效。
model UserRoleAssignment {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

/// M-SSO P0.3：refresh 令牌持久化（SSO 硬前置）。
/// 轮换检测：verifyRefresh 收到已 rotated 的 jti 视为重放攻击，整链 revoke。
model RefreshToken {
  id          String    @id @default(uuid(7))
  jti         String    @unique
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 签发方：null = 主站自有 Cookie 会话；否则为 OidcClient.clientId
  clientId    String?   @map("client_id")
  /// 轮换链头（首次签发的 jti），同链查询/整链撤销锚点
  chainId     String    @map("chain_id")
  /// 轮换来源（上一代 jti）；首代为 null
  rotatedFrom String?   @map("rotated_from")
  /// 该 jti 是否已被轮换消费（消费后出现 = 重放）
  rotatedAt   DateTime? @map("rotated_at")
  revokedAt   DateTime? @map("revoked_at")
  expiresAt   DateTime  @map("expires_at")
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([chainId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// M-SSO P1.1：SSO 接入方（Relying Party）注册表。
/// redirectUris 为精确匹配白名单；scopes 决定可索取的资源面（openid/profile/wallet:read/billing:write）。
model OidcClient {
  id               String   @id @default(uuid(7))
  clientId         String   @unique @map("client_id")
  name             String
  clientSecretHash String   @map("client_secret_hash")
  redirectUris     String[] @map("redirect_uris")
  /// 单点登出回调（back-channel，阶段 2 启用）
  logoutUri        String?  @map("logout_uri")
  scopes           String[] @default(["openid", "profile", "wallet:read"])
  /// 公共客户端（无 secret，强制 PKCE）；first-party 服务端应用可关闭
  pkceRequired     Boolean  @default(true) @map("pkce_required")
  firstParty       Boolean  @default(false) @map("first_party")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  consents OidcUserConsent[]

  @@map("oidc_clients")
}

/// M-SSO-FOLLOWUP D1：用户对第三方 client 的授权同意记录（first-party 免同意）。
model OidcUserConsent {
  id        String     @id @default(uuid(7))
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 逻辑外键：指向 OidcClient.clientId（业务标识而非 uuid 主键）
  clientId  String     @map("client_id")
  client    OidcClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  scopes    String[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([userId, clientId])
  @@map("oidc_user_consents")
}

enum UserRole {
  GUEST       @map("0")
  USER        @map("1")
  MODERATOR   @map("10")
  ADMIN       @map("99")
  SUPER_ADMIN @map("100")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

// 用户等级（区别于模型等级 ModelTierLevel）
enum AccountTier {
  NORMAL @map("1")
  PRO    @map("2")
  MAX    @map("3")
}

// 用户扩展资料
model UserProfile {
  id     String @id @default(uuid(7))
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  realName String? @map("real_name")
  phone    String?
  company  String?
  position String?
  bio      String?
  website  String?
  github   String?
  wechat   String?

  preferences Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

// 网关调用 API Key（用户级密钥，区别于平台 Key 池）
model ApiKey {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  keyId       String   @unique @map("key_id")
  name        String
  keyHash     String   @map("key_hash")
  permissions String[] @default([])
  rateLimit   Json?    @map("rate_limit")

  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

// ==================== 厂商与模型（天梯图核心） ====================

model Vendor {
  id     String  @id @default(uuid(7))
  code   String  @unique // 厂商代码：openai, anthropic, deepseek
  name   String
  nameCn String? @map("name_cn")
  nameEn String? @map("name_en")

  logoUrl    String? @map("logo_url")
  brandColor String? @map("brand_color")
  website    String?

  tierLevel  Int     @default(1) @map("tier_level")
  isFeatured Boolean @default(false) @map("is_featured")
  // 天梯矩阵图列排序优先级（v1.9）：1-99，数值越小优先级越高，离性能轴越近；后台管理员可配
  priority   Int     @default(50) @map("priority")

  companyName   String? @map("company_name")
  country       String?
  foundedYear   Int?    @map("founded_year")
  description   String?
  descriptionCn String? @map("description_cn")

  modelCount Int     @default(0) @map("model_count")
  isActive   Boolean @default(true) @map("is_active")
  sortOrder  Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  models AiModel[]

  @@index([tierLevel])
  @@index([isActive])
  @@map("vendors")
}

model AiModel {
  id          String  @id @default(uuid(7))
  modelCode   String  @unique @map("model_code") // gpt-4o, claude-3-opus
  nameDisplay String  @map("name_display")
  nameCn      String? @map("name_cn")
  nameEn      String? @map("name_en")
  slug        String  @unique

  vendorId String @map("vendor_id")
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  modelType  ModelType @map("model_type")
  categoryId String?   @map("category_id") // 专业/应用版

  // 技术参数
  parameterCount  String? @map("parameter_count")
  contextLength   Int?    @map("context_length")
  maxOutputTokens Int?    @map("max_output_tokens")

  // 特性
  isOpenSource      Boolean @default(false) @map("is_open_source")
  isMultiModal      Boolean @default(false) @map("is_multi_modal")
  isReasoning       Boolean @default(false) @map("is_reasoning")
  isCodingOptimized Boolean @default(false) @map("is_coding_optimized")

  protocol ModelProtocol @default(OPENAI)

  officialUrl String? @map("official_url")
  docsUrl     String? @map("docs_url")
  apiUrl      String? @map("api_url")
  githubUrl   String? @map("github_url")
  paperUrl    String? @map("paper_url")

  publishedAt  DateTime?   @map("published_at")
  deprecatedAt DateTime?   @map("deprecated_at")
  status       ModelStatus @default(ACTIVE)
  visibility   Visibility  @default(PUBLIC)

  // 评分冗余（方便排序）
  benchmarkScore  Float? @map("benchmark_score")
  popularityScore Float? @map("popularity_score")

  isActive       Boolean  @default(true) @map("is_active")
  isFeatured     Boolean  @default(false) @map("is_featured")
  featuredWeight Int      @default(0) @map("featured_weight")
  sortOrder      Int      @default(0) @map("sort_order")
  tags           String[] @default([])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  prices          ModelPrice[]
  benchmarks      Benchmark[]
  scores          ModelScore[]
  rankings        LadderRanking[]
  evaluations     EvaluationModel[]
  changeLogs      ModelChangeLog[]
  tierMappings    UserTierMapping[]
  modelPriorities UserModelPriority[]
  freeQuotas      UserFreeQuota[]
  quotaUsages     UserQuotaUsage[]
  offerings       ProviderModelOffering[]

  @@index([vendorId])
  @@index([modelType])
  @@index([status])
  @@index([isActive])
  @@index([benchmarkScore])
  @@map("ai_models")
}

enum ModelType {
  CHAT       @map("1")
  REASONING  @map("2")
  MULTIMODAL @map("3")
  CODE       @map("4")
  VISION     @map("5")
  AUDIO      @map("6")
  EMBEDDING  @map("7")
  RERANK     @map("8")
  ASR        @map("9")
  TTS        @map("10")
  IMAGE_GEN  @map("11")
  VIDEO      @map("12")
  SYSTEM     @map("13")
}

enum ModelProtocol {
  OPENAI    @map("1")
  ANTHROPIC @map("2")
  GOOGLE    @map("3")
  CUSTOM    @map("4")
  RESPONSES @map("5")
}

enum ModelStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
  BETA
}

enum Visibility {
  PUBLIC     @map("1")
  LOGIN_ONLY @map("2")
  PAID_ONLY  @map("3")
  HIDDEN     @map("4")
}

// 模型价格（统一 ¥/M Tokens；限时优惠 = sourceType=PROMOTION 的价格行，
// effectiveFrom/Until 为优惠窗口，直接作为计费基准价）
model ModelPrice {
  id      String  @id @default(uuid(7))
  modelId String  @map("model_id")
  model   AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  priceCache      Decimal? @map("price_cache") @db.Decimal(19, 6)
  priceInput      Decimal  @map("price_input") @db.Decimal(19, 6)
  priceOutput     Decimal  @map("price_output") @db.Decimal(19, 6)
  pricePerRequest Decimal? @map("price_per_request") @db.Decimal(19, 6)

  billingMode     BillingMode @default(PER_TOKEN) @map("billing_mode")
  billingCurrency String      @default("CNY") @map("billing_currency")
  billingUnit     String      @default("per_1k_tokens") @map("billing_unit") // D5 修复：计价粒度（per_1k_tokens / per_million_tokens / per_request 等）

  originalCurrency    String?  @map("original_currency")
  originalPriceInput  Decimal? @map("original_price_input") @db.Decimal(19, 6)
  originalPriceOutput Decimal? @map("original_price_output") @db.Decimal(19, 6)
  exchangeRate        Decimal? @map("exchange_rate") @db.Decimal(10, 6)

  effectiveFrom  DateTime  @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")
  isCurrent      Boolean   @default(true) @map("is_current")

  sourceType PriceSource @default(OFFICIAL) @map("source_type")
  sourceName String?     @map("source_name")
  sourceUrl  String?     @map("source_url")
  notes      String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([modelId, isCurrent]) // D3 修复：防止并发 sync 产生多条 isCurrent=true
  @@index([modelId])
  @@index([isCurrent])
  @@index([effectiveFrom])
  @@map("model_prices")
}

enum BillingMode {
  PER_TOKEN   @map("1")
  PER_REQUEST @map("2")
  PER_MINUTE  @map("3")
  FREE        @map("4")
}

enum PriceSource {
  OFFICIAL    @map("1")
  API_STATION @map("2")
  USER_SUBMIT @map("3")
  CRAWLER     @map("4")
  PROMOTION   @map("5") // 限时优惠（折扣或免费）
}

// ==================== 模型提供商（平台级聚合） ====================

// 模型提供商：平台级实体，聚合多个模型，定义充值比例（1 元 = rechargeRatio 外币）
// 与 Vendor 区别：Vendor 是模型研发厂商（OpenAI/Anthropic），ModelProvider 是平台聚合商/中转站
model ModelProvider {
  id     String  @id @default(uuid(7))
  code   String  @unique // 提供商代码：siliconflow, openrouter, deepseek-official
  name   String
  nameCn String? @map("name_cn")
  nameEn String? @map("name_en")

  logoUrl       String? @map("logo_url")
  brandColor    String? @map("brand_color")
  website       String?
  apiUrl        String? @map("api_url")
  description   String?
  descriptionCn String? @map("description_cn")

  // 充值比例：1 元 = rechargeRatio 外币（如 20 表示 1元=$20）
  rechargeRatio    Decimal @map("recharge_ratio") @db.Decimal(10, 4)
  // 标价币种（USD/CNY/EUR 等），默认 USD
  priceCurrency    String  @default("USD") @map("price_currency")
  // 充值币种（用户充值币种，默认 CNY）
  rechargeCurrency String  @default("CNY") @map("recharge_currency")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  offerings ProviderModelOffering[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("model_providers")
}

// 提供商 × 模型 挂载（每个模型在每个提供商的上线信息、标价、倍率、折扣价）
model ProviderModelOffering {
  id         String        @id @default(uuid(7))
  providerId String        @map("provider_id")
  provider   ModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  modelId String  @map("model_id")
  model   AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  // 上线时间（该模型在该提供商平台的上线时间）
  listedAt DateTime? @map("listed_at")

  // 可用倍率（默认 1.0）
  defaultMultiplier Decimal @default(1.0) @map("default_multiplier") @db.Decimal(8, 4)

  // 标价（原币，单位由 priceUnit 指定：per_1k_tokens 或 per_million_tokens）
  priceInput  Decimal? @map("price_input") @db.Decimal(19, 6)
  priceOutput Decimal? @map("price_output") @db.Decimal(19, 6)
  priceCache  Decimal? @map("price_cache") @db.Decimal(19, 6)
  priceUnit   String   @default("per_million_tokens") @map("price_unit")

  // 折扣价（元/M Tokens，由 标价/(充值比例×倍率) 计算；可为区间）
  discountInputMin  Decimal? @map("discount_input_min") @db.Decimal(19, 6)
  discountInputMax  Decimal? @map("discount_input_max") @db.Decimal(19, 6)
  discountOutputMin Decimal? @map("discount_output_min") @db.Decimal(19, 6)
  discountOutputMax Decimal? @map("discount_output_max") @db.Decimal(19, 6)
  discountCacheMin  Decimal? @map("discount_cache_min") @db.Decimal(19, 6)
  discountCacheMax  Decimal? @map("discount_cache_max") @db.Decimal(19, 6)

  // 有效窗口
  effectiveFrom  DateTime  @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([providerId, modelId])
  @@index([providerId])
  @@index([modelId])
  @@index([isActive])
  @@map("provider_model_offerings")
}

// 模型综合评分（四维加权）
