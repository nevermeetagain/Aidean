// ==================== 数据同步 ====================

// 定时脚本
model ScheduledScript {
  id             String  @id @default(uuid(7))
  name           String
  description    String?
  scriptPath     String  @map("script_path")
  params         Json?
  cronExpression String? @map("cron_expression")
  intervalDays   Int?    @map("interval_days")
  intervalCount  Int?    @map("interval_count")
  triggerTime    String? @map("trigger_time")

  lastRunAt DateTime? @map("last_run_at")
  nextRunAt DateTime? @map("next_run_at")

  status   Int     @default(1)
  isActive Boolean @default(true) @map("is_active")

  executions ScriptExecution[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  version   Int       @default(1)

  @@index([isActive])
  @@index([nextRunAt])
  @@map("scheduled_scripts")
}

model ScriptExecution {
  id       String          @id @default(uuid(7))
  scriptId String          @map("script_id")
  script   ScheduledScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  status     Int       @default(0) // 0:执行中 1:成功 2:失败
  startedAt  DateTime  @map("started_at")
  finishedAt DateTime? @map("finished_at")
  durationMs Int?      @map("duration_ms")
  output     String?   @db.Text
  errorMsg   String?   @map("error_msg") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([scriptId])
  @@index([status])
  @@index([startedAt])
  @@map("script_executions")
}

// 模型变更历史（字段级快照，支持回滚）
model ModelChangeLog {
  id      String  @id @default(uuid(7))
  modelId String  @map("model_id")
  model   AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  syncBatchId String?    @map("sync_batch_id")
  syncBatch   SyncBatch? @relation(fields: [syncBatchId], references: [id], onDelete: SetNull)

  changeType String @map("change_type") // CREATE | UPDATE | DELETE | SYNC

  beforeData    Json?    @map("before_data")
  afterData     Json?    @map("after_data")
  changedFields String[] @map("changed_fields")

  source     String? @map("source") // sync_script | admin_manual | api
  sourceIp   String? @map("source_ip")
  operatorId String? @map("operator_id")

  isReverted   Boolean   @default(false) @map("is_reverted")
  revertedAt   DateTime? @map("reverted_at")
  revertReason String?   @map("revert_reason")

  validationStatus String  @default("pending") @map("validation_status")
  checksum         String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([modelId, createdAt])
  @@index([syncBatchId])
  @@index([changeType, createdAt])
  @@map("model_change_logs")
}

// 同步批次
model SyncBatch {
  id        String @id @default(uuid(7))
  batchCode String @unique @map("batch_code")

  source    String? @map("source") // official_api | crawler | manual
  sourceUrl String? @map("source_url")

  totalRecords   Int @default(0) @map("total_records")
  successRecords Int @default(0) @map("success_records")
  failedRecords  Int @default(0) @map("failed_records")

  status String @default("running") @map("status") // running | completed | failed | partial

  validationSummary Json? @map("validation_summary")
  errorSamples      Json? @map("error_samples")

  operatorId    String? @map("operator_id")
  operatorNotes String? @map("operator_notes")

  changeLogs ModelChangeLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("sync_batches")
}

