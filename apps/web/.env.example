# Aidean Web 环境变量模板
# [T120-05 2026-10-23 外部助手] 归一口径：apps/web 代码读取的每一个 process.env 变量都必须在下方登记且带注释。
# 守卫：node scripts/guard/env-diff.mjs（referenced − example 必须为 ∅；反向差集只报告不阻断）。
# 标注含义 —— 必需＝缺失即启动/功能不可用；可选＝代码内有默认值或走降级分支（本卡不改任何既有默认值语义）。
# 另两份模板：apps/web/.env.smtp.example（SMTP 专项）、docker/.env.example（编排层真源，含 compose 专用键）。

# ============================
# 必需：数据与签名密钥
# ============================
# 必需｜PostgreSQL 连接串：Prisma 客户端唯一来源（缺失＝全站数据面不可用）
DATABASE_URL="postgresql://root:password@localhost:5432/aidean"

# 必需｜会话令牌签名密钥：lib/env-check.ts:8（assertJwtSecret fail-fast）与 lib/features/apikey/crypto.ts:18（StationUserKey AES-256-GCM 密钥派生）
# 生产必须替换为高强度随机串（≥32 字符），缺失或清空会使签发/渠道密钥加密抛错
JWT_SECRET="change-me-in-production"

# ============================
# 可选（生产必配）：有降级语义，留空即走开发兜底
# ============================
# 可选（生产必配）｜Redis 连接串：lib/db/redis.ts:131 getRedis() 缺失恒返回 null → 缓存/限流/密钥环走直查与进程内降级
REDIS_URL="redis://localhost:6379"

# 可选（生产必配）｜站点公开基址：既是 OIDC issuer（lib/features/auth/constants.ts:82 AUTH_ISSUER）也是 metadataBase（app/layout.tsx:20）
# 缺失回落 http://localhost:3000；镜像构建期必须由 --build-arg 注入（Dockerfile RC-02 / REL-ENG-02 fail-closed，NEXT_PUBLIC_* 为构建期内联）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 可选（生产必配）｜JWT RS256 私钥（PKCS#8 PEM，允许用 \n 转义单行书写）：lib/features/auth/keys.ts:75
# 缺失时首次启动在 Redis 密钥环自动生成首代密钥（无 Redis 则降级为进程内密钥，重启即换钥并使既有令牌失效），故生产建议显式注入
# 写法：整段 PEM 存不进一行时，改用部署平台的 secret 文件挂载
# JWT_PRIVATE_KEY=

# 可选（生产必配）｜支付回调验签密钥：lib/features/billing/service.ts:183 HMAC-SHA256(orderId)
# 缺失回落 "aidean-dev-notify-secret"（仅可用于 dev mock 渠道）；生产必须替换，否则回调验签等同公开
# BILLING_NOTIFY_SECRET=

# 可选（生产必配）｜内部服务令牌：scheduler sidecar 以 Authorization: Bearer <token> 调用 /api/v1/admin/scripts/run-due
# （app/api/v1/admin/scripts/run-due/route.ts:40 定长比较）；缺失＝该端点只认管理员会话，sidecar 自动调度不可用。生产须 ≥32 字符随机串
ADMIN_API_TOKEN=""

# ============================
# 可选：SMTP 发信（专项模板见 apps/web/.env.smtp.example）
# ============================
# 可选｜SMTP 服务器地址：lib/features/auth/mailer.ts:14——SMTP_HOST/SMTP_USER/SMTP_PASS 任一缺失 → 验证码只打服务端日志、不发信（绝不回传 HTTP 响应）
SMTP_HOST=""

# 可选｜SMTP 端口（465=SSL/TLS，587=STARTTLS）：mailer.ts:20，缺省 465；secure 判定即 port===465
SMTP_PORT=465

# 可选｜SMTP 登录用户名（通常为完整邮箱地址；163 邮箱须用授权码而非登录密码）：mailer.ts:16
SMTP_USER=""

# 可选｜SMTP 登录密码或授权码：mailer.ts:17
SMTP_PASS=""

# 可选｜发件人显示地址，缺省沿用 SMTP_USER：mailer.ts:29 采用 ?? 判定，故此处保持注释态——
# 填了空串会让 from 变成空值（?? 不吞空串），而非回落到 SMTP_USER
# SMTP_FROM="Aidean <noreply@example.com>"

# ============================
# 可选：第三方登录/支付占位
# ============================
# 可选｜微信开放平台 AppID：app/api/v1/wechat/qrcode/route.ts:14 缺失＝扫码登录返回「未配置」而非 500
WECHAT_APPID=

# 可选｜微信 AppSecret：当前 apps/web 代码未读取（仅与 WECHAT_APPID 成对占位，待服务端换取 token 的读取点落地）
# WECHAT_SECRET=

# ============================
# 可选：出站代理（URL 安全策略的代理白名单前提）
# ============================
# 可选｜lib/security/url-policy.ts:220：仅当显式设置且可解析时生效，大小写两种写法均被读取；不设＝不走代理
# HTTP_PROXY=
# HTTPS_PROXY=
# http_proxy=
# https_proxy=

# ============================
# 可选：测试/构建开关（值语义由代码内的字面量比较决定，勿改判定形式）
# ============================
# 可选｜="1" 时纳入依赖真实库的 *.int.spec.ts（lib/features/pricing/__tests__/effective-price.int.spec.ts:12 等，与 DATABASE_URL 同时具备才启用）
RUN_DB_TESTS=0

# 可选｜="1" 时开放 /api/v1/mock-upstream/[...path] mock 上游（app/api/v1/mock-upstream/[...path]/route.ts:27），生产严禁开启
AIDEAN_ENABLE_MOCK_UPSTREAM=0

# 可选｜="1" 且非生产时旁路登录限流（lib/features/auth/constants.ts:142），生产恒无效——仅供 e2e/本地压测
AIDEAN_BYPASS_LOGIN_RATE_LIMIT=0

# 可选｜="0" 时关闭网关流式透传（lib/features/gateway/service.ts:952 PASSTHROUGH_ENABLED 采用 !=="0" 判定），缺省开启
AIDEAN_GATEWAY_STREAM_PASSTHROUGH=1

# 可选｜Next.js 构建输出目录（next.config.mjs:9 distDir），缺省 ".next"；仅影响构建期
AIDEAN_DIST_DIR=".next"

# ============================
# 可选：由框架或部署环境注入，本地一般无需设置
# ============================
# 可选｜cron 解析与调度时区：lib/features/admin/script-validation.ts:23、script-executor.ts:385，缺省 Asia/Shanghai
TZ="Asia/Shanghai"

# 可选｜运行环境：next dev=development、next build/start=production、vitest=test；启动期校验（lib/config/env.ts）据此决定 fail-fast 或降级告警
# NODE_ENV=

# ============================
# Docker 开发编排（docker/docker-compose.dev.yml 使用；编排层真源 docker/.env.example）
# 可选｜以下键 apps/web 代码不读取，仅被 compose 消费
# ============================
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=aidean
PGADMIN_EMAIL=admin@aidean.local
PGADMIN_PASSWORD=password

# 第三方登录/支付占位（按需取消注释并填写）
# 支付宝（ALIPAY_*）：应用 APPID 与加签私钥等，按支付宝开放平台文档补充；当前代码未读取
# ALIPAY_APPID=
# ALIPAY_PRIVATE_KEY=
