# 数据库
DATABASE_URL="postgresql://root:password@localhost:5432/aidean"

# 缓存
REDIS_URL="redis://localhost:6379"

# 认证
JWT_SECRET="change-me-in-production"

# 站点
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 内部服务令牌（D2 修复）
# scheduler sidecar 以 Authorization: Bearer <ADMIN_API_TOKEN> 调用 run-due 端点。
# 生产环境必须设置为高强度随机字符串（≥32 字符），勿使用默认值。
ADMIN_API_TOKEN=""

# Docker 开发环境（docker/docker-compose.dev.yml 使用）
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=aidean
PGADMIN_EMAIL=admin@aidean.local
PGADMIN_PASSWORD=password

# 第三方登录/支付占位（按需取消注释并填写）
# WECHAT_APPID=
# WECHAT_SECRET=
# 支付宝（ALIPAY_*）：应用 APPID 与加签私钥等，按支付宝开放平台文档补充
# ALIPAY_APPID=
# ALIPAY_PRIVATE_KEY=
