# Aidean SMTP 邮件配置模板
# 复制为 .env.local 并填入真实值后生效
# mailer.ts 在 SMTP_HOST/SMTP_USER/SMTP_PASS 缺失时走日志兜底（不发信）

# SMTP 服务器地址（测试期可用 smtp.163.com；正式建议腾讯云 SES SMTP）
SMTP_HOST=smtp.example.com

# SMTP 端口（465=SSL/TLS，587=STARTTLS）
SMTP_PORT=465

# SMTP 登录用户名（通常为完整邮箱地址）
SMTP_USER=noreply@example.com

# SMTP 登录密码或授权码（163邮箱用授权码，非登录密码）
SMTP_PASS=your-smtp-password-or-auth-code

# 发件人地址（默认使用 SMTP_USER）
SMTP_FROM="Aidean <noreply@example.com>"
