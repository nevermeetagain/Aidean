{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --turbo",
    "build": "next build && node scripts/postbuild-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:matrix": "tsx prisma/seed-matrix-backfill.ts",
    "db:seed:products": "node scripts/seed-products.mjs",
    "db:check:tables": "node scripts/check-tables.mjs",
    "db:studio": "prisma studio",
    "contract:build": "node scripts/check-runtime-contract.mjs --mode build",
    "contract:build:strict": "node scripts/check-runtime-contract.mjs --mode build --strict",
    "contract:runtime": "node scripts/check-runtime-contract.mjs --mode runtime",
    "contract:runtime:strict": "node scripts/check-runtime-contract.mjs --mode runtime --strict",
    "test": "vitest run",
    "crawl:models": "tsx ../../scripts/crawl/crawl_models.ts",
    "crawl:agents": "tsx ../../scripts/crawl/crawl_agents.ts",
    "crawl:mcp": "tsx ../../scripts/crawl/crawl_mcp.ts",
    "crawl:skills": "tsx ../../scripts/crawl/crawl_skills.ts",
    "crawl:fx": "tsx ../../scripts/crawl/fx_daily.ts",
    "ranking:update": "tsx ../../scripts/ranking/update_ranking.ts"
  },
  "dependencies": {
    "@aidean/shared": "workspace:*",
    "@aidean/ui": "workspace:*",
    "@node-rs/bcrypt": "^1.10.9",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "echarts": "^5.5.0",
    "ioredis": "^5.4.1",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "0.453.0",
    "marked": "^12.0.2",
    "next": "15.0.0",
    "nodemailer": "^10.0.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.8.1",
    "redis": "^5.11.0",
    "sanitize-html": "2.13.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "undici": "7.16.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "20.14.12",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/sanitize-html": "^2.13.0",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "10.4.20",
    "browserslist": "^4.29.0",
    "caniuse-lite": "^1.0.30001810",
    "eslint": "8.57.0",
    "eslint-config-next": "15.0.0",
    "postcss": "8.4.41",
    "postcss-scss": "^4.0.9",
    "prisma": "^6.19.3",
    "tailwindcss": "4.0.0",
    "tsx": "^4.19.0",
    "typescript": "5.5.4",
    "vitest": "^2.1.9"
  }
}