# Aidean 环境变量模板
# 复制此文件为 .env 并填入实际值

# ============================
# PostgreSQL 配置
# ============================
POSTGRES_USER=root
POSTGRES_PASSWORD=NewPassword123!
POSTGRES_DB=aidean

# 复制用户密码 (用于流复制)
REPLICATOR_PASSWORD=ReplicatorPass2026!

# ============================
# Redis 配置
# ============================
REDIS_PASSWORD=RedisPass2026!

# ============================
# 应用配置
# ============================
# 开发环境
DATABASE_URL_DEV=postgresql://root:NewPassword123!@localhost:5432/aidean
REDIS_URL_DEV=redis://:@localhost:6379/0

# 生产环境 (Docker内网)
DATABASE_URL_PROD=postgresql://root:${POSTGRES_PASSWORD}@postgres-primary:5432/aidean
REDIS_URL_PROD=redis://:${REDIS_PASSWORD}@redis-primary:6379/0

# PgBouncer连接
DATABASE_URL_POOL=postgresql://root:${POSTGRES_PASSWORD}@pgbouncer:6432/aidean

# ============================
# Snowflake ID 配置
# ============================
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_DATACENTER_ID=1

# ============================
# Redis 缓存配置
# ============================
CACHE_TTL_MODEL_DETAIL=3600
CACHE_TTL_LADDER_LIST=300
CACHE_TTL_USER_PROFILE=1800

# ============================
# JWT 配置
# ============================
JWT_SECRET=YourJWTSecretKey2026!
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================
# Web 服务配置（docker-compose.prod.yml web 服务引用）
# ============================
NEXT_PUBLIC_SITE_URL=http://your-domain.com

# ============================
# 内部服务令牌（D2 修复）
# scheduler sidecar 以 Bearer token 调用 run-due 端点。
# 生产环境必须设置为高强度随机字符串（≥32 字符）。
# ============================
ADMIN_API_TOKEN=

# ============================
# 支付配置 (示例)
# ============================
WECHAT_PAY_APP_ID=your_app_id
WECHAT_PAY_MCH_ID=your_mch_id
WECHAT_PAY_API_KEY=your_api_key
ALIPAY_APP_ID=your_app_id
ALIPAY_PRIVATE_KEY=your_private_key

# ============================
# 第三方服务
# ============================
RAGFLOW_BASE_URL=http://36.134.158.50:10001
RAGFLOW_API_KEY=your_ragflow_api_key

# ============================
# 日志级别
# ============================
LOG_LEVEL=info
NODE_ENV=development

# ============================
# SMTP 邮件发信（R-58）
# 未配置时验证码仅打服务端日志（dev 兜底），生产环境会抛 50000 错误。
# 配置后 nodemailer 自动启用真实发信，无需额外安装依赖。
# ============================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
