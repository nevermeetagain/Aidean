{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [],
      "outputs": [],
      "cache": false
    },
    "db:generate": {
      "outputs": ["node_modules/.prisma/client/**"]
    },
    "db:push": {},
    "db:migrate": {},
    "db:seed": {}
  },
  "globalDependencies": [".env*"],
  "globalEnv": ["DATABASE_URL", "REDIS_URL", "JWT_SECRET"]
}
